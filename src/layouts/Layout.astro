---
import { LANGS, HTML_LANG, OG_LOCALE, localePath, type Lang } from '../i18n';

interface Props {
  title: string;
  description?: string;
  /** 表示言語（既定: ja） */
  lang?: Lang;
  /** 言語プレフィックスを除いたパス（例: "/ssi/"）。hreflang と言語切替リンクに使う */
  path?: string;
}
const { title, description = "We Build, Operate, and Value up AI", lang = 'ja', path } = Astro.props;
const siteUrl = "https://ssibov.com";
const ogUrl = new URL(Astro.url.pathname, siteUrl).href;
const siteName = lang === 'en' ? 'Shinetsu Science Industry Co., Ltd.' : lang === 'zh' ? '信越科學產業股份有限公司' : '信越科学産業株式会社';
// hreflang 用：言語プレフィックスを除いたパスを求める（props が無ければ URL から推定）
const basePath = path ?? (Astro.url.pathname.replace(/^\/(en|zh)(?=\/|$)/, '') || '/');
const alternates = LANGS.map((l) => ({ l, href: new URL(localePath(l, basePath), siteUrl).href }));
const fontHref = lang === 'zh'
  ? "https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Noto+Sans+TC:wght@300;400;500;600;700&family=Noto+Serif+TC:wght@400;500;600&family=Noto+Sans+JP:wght@300;400;500&display=swap"
  : "https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Noto+Sans+JP:wght@300;400;500;600;700&family=Noto+Serif+JP:wght@400;500;600&display=swap";
---
<!DOCTYPE html>
<html lang={HTML_LANG[lang]}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<!-- OGP（LINE・SNSのリンクプレビュー用） -->
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={ogUrl}>
<link rel="canonical" href={ogUrl}>
{alternates.map(({ l, href }) => <link rel="alternate" hreflang={HTML_LANG[l]} href={href} />)}
<link rel="alternate" hreflang="x-default" href={alternates[0].href} />
<meta property="og:type" content="website">
<meta property="og:site_name" content={siteName}>
<meta property="og:locale" content={OG_LOCALE[lang]}>
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href={fontHref} rel="stylesheet">
<script src="https://unpkg.com/lucide@latest" is:inline></script>
<slot name="head" />
<style is:global>
:root{--gd:#061F14;--g:#0B3B24;--au:#B08D3B;--aul:#D4AF5A;--cr:#F6F4EF;--crw:#EEEBE3;--w:#FFF;--ch:#1A1A1A;--g5:#6B6B6B;--g3:#B0B0B0;--g1:#E8E8E8}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;overflow-x:hidden}
body{font-family:'DM Sans','Noto Sans JP','Hiragino Kaku Gothic ProN',Meiryo,sans-serif;-webkit-font-smoothing:antialiased;background:var(--cr);color:var(--ch);overflow-x:hidden}
::-webkit-scrollbar{width:6px}::-webkit-scrollbar-track{background:var(--cr)}::-webkit-scrollbar-thumb{background:var(--g);border-radius:3px}
::selection{background:var(--au);color:var(--w)}

/* 繁体字ページ：本文・見出しを Noto Sans/Serif TC に切り替え */
html[lang="zh-Hant"] body{font-family:'DM Sans','Noto Sans TC','Noto Sans JP','PingFang TC','Microsoft JhengHei',sans-serif}
html[lang="zh-Hant"] .hero__t,html[lang="zh-Hant"] .gw-card-title,html[lang="zh-Hant"] .ak-h3,html[lang="zh-Hant"] .ak-off__n,html[lang="zh-Hant"] .ph-c__title,html[lang="zh-Hant"] .news-hero__title{font-family:'Noto Serif TC','Noto Serif JP',serif !important}
/* 英語ページ：日本語向けの nowrap 見出しは折り返しを許可 */
html[lang="en"] .hero__t,html[lang="en"] .st{white-space:normal !important}

/* ========== LANGUAGE SWITCH ========== */
.lsw{display:flex;align-items:center;gap:.6rem;margin-left:2rem;font-family:'DM Sans','Noto Sans JP',sans-serif;font-size:10px;font-weight:600;letter-spacing:.15em}
.lsw a{color:#8BBF9F;text-decoration:none;transition:color .3s;padding:2px 0;border-bottom:1px solid transparent}
.lsw a:hover{color:#C9A227}
.lsw a[aria-current="true"]{color:#C9A227;border-bottom-color:#C9A227}
.lsw__sep{color:rgba(139,191,159,.5)}
.mmenu .lsw{margin:1.5rem 0 0;font-size:.85rem;gap:1rem}
.mmenu .lsw a{color:var(--g)}
.mmenu .lsw a[aria-current="true"]{color:#C9A227}
@media(max-width:768px){.nav__i .lsw{display:none}}

/* ========== NAVIGATION ========== */
.nav{position:fixed;top:0;left:0;width:100%;z-index:100;transition:all .6s cubic-bezier(.16,1,.3,1)}
.nav--s{background:rgba(246,244,239,.92);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-bottom:1px solid rgba(11,59,36,.08)}
.nav__i{display:flex;justify-content:space-between;align-items:center;padding:2rem 4vw;transition:padding .6s cubic-bezier(.16,1,.3,1)}
.nav--s .nav__i{padding:1.2rem 4vw}
.nav__logo img{height:36px;width:auto;mix-blend-mode:multiply;transition:all .5s}
.nav__ls{display:flex;gap:2.5rem;align-items:center}

/* メニュー項目 (2行対応 & アニメーション) */
.nav__l {
  position: relative; display: inline-flex; flex-direction: column; overflow: hidden;
  font-size: 11px; font-weight: 500; letter-spacing: .18em; color: #8BBF9F; text-decoration: none; padding-bottom: 6px;
}
.nav__l span { transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s; }
.nav__l::before {
  content: attr(data-ja); position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  font-family: 'DM Sans', 'Noto Sans JP', sans-serif; font-size: 10px; font-weight: 600; color: #C9A227;
  transform: translateY(30px); opacity: 0;
  transition: opacity 0.4s, transform 0.4s cubic-bezier(.16,1,.3,1);
}
.nav__l span:hover { color: #C9A227; }
.nav__l:hover::before { opacity: 1; transform: translateY(0); }
.nav__l:hover span { opacity: 0; transform: translateY(-30px); }
.nav__l::after {
  content: ''; position: absolute; bottom: 0; left: 0; width: 0; height: 1px;
  background: #C9A227; transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}
.nav__l:hover::after { width: 100%; }
.nav--s .nav__l{color:#8BBF9F}
.nav--s .nav__l span:hover { color: #C9A227; }

/* ハンバーガーメニュー & モバイルメニュー */
.ham{display:none;background:none;border:none;cursor:pointer;width:32px;height:20px;position:relative;z-index:110}
.ham span{display:block;width:100%;height:1.5px;background:var(--g);position:absolute;left:0;transition:all .4s cubic-bezier(.16,1,.3,1)}
.ham span:nth-child(1){top:0}.ham span:nth-child(2){top:50%;transform:translateY(-50%)}.ham span:nth-child(3){bottom:0}
.ham.open span:nth-child(1){top:50%;transform:translateY(-50%) rotate(45deg)}.ham.open span:nth-child(2){opacity:0}.ham.open span:nth-child(3){bottom:50%;transform:translateY(50%) rotate(-45deg)}
.mmenu{position:fixed;inset:0;background:var(--cr);z-index:100;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:2.5rem;transform:translateY(-100%);transition:transform .7s cubic-bezier(.16,1,.3,1)}
.mmenu.open{transform:translateY(0)}
.mmenu a { position: relative; display: inline-flex; flex-direction: column; overflow: hidden; font-size: 2rem; font-weight: 300; color: var(--g); text-decoration: none; letter-spacing: .08em; }
.mmenu a span { transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s; }
.mmenu a::before {
  content: attr(data-ja); position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  font-family: 'DM Sans', 'Noto Sans JP', sans-serif; font-size: 1.5rem; font-weight: 500; color: #C9A227;
  transform: translateY(50px); opacity: 0; transition: opacity 0.4s, transform 0.4s cubic-bezier(.16,1,.3,1);
}
.mmenu a span:hover { color: #C9A227; }
.mmenu a:hover::before { opacity: 1; transform: translateY(0); }
.mmenu a:hover span { opacity: 0; transform: translateY(-50px); }

/* ========== HERO SECTION ========== */
.hero {
  position: relative; display: flex; flex-direction: column; overflow: hidden; background: var(--w);
  min-height: 100vh; justify-content: center; align-items: center;
}
.hero__c{position:relative;z-index:3;padding:0 4vw;width:100%}
.hero__up{padding-top:8rem;padding-bottom:2rem;max-width:1400px;margin:0 auto}
.hero__ey{font-size:10px;font-weight:600;letter-spacing:.35em;text-transform:uppercase;color:var(--au);margin-bottom:2rem;opacity:0;transform:translateY(20px);animation:fu 1s .3s forwards}
.hero__t{font-size:clamp(2.2rem,4.5vw,4.5rem);font-weight:300;line-height:1.2;color:var(--gd);margin-bottom:1.5rem;opacity:0;transform:translateY(30px);animation:fu 1.2s .5s forwards}
.hero__t em{font-style:normal;color:var(--aul)}
.hero__sub{font-size:.92rem;font-weight:300;color:var(--g5);max-width:640px;line-height:1.9;letter-spacing:.02em;opacity:0;transform:translateY(20px);animation:fu 1s .8s forwards}

/* 動画コンテナ (シネマスコープ比率・黒帯完全除去) */
.hero__video{margin-top:3.5rem;opacity:0;transform:translateY(20px);animation:fu 1s 1s forwards;border-radius:12px;overflow:hidden;border:1px solid var(--g1);box-shadow:0 20px 40px rgba(0,0,0,0.06);background:var(--w)}
.hero__video video{width:100%;display:block;aspect-ratio:21.999999999999999999999999999999999999999999/9;object-fit:cover}

/* ========== WHY SECTION ========== */
.hero__why{position:relative;z-index:3;max-width:1400px;margin:0 auto;padding:3rem 4vw 2.5rem;opacity:0;transform:translateY(30px);animation:fu 1s .9s forwards}
.why__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border:1px solid var(--g1)}
.why-card{border-right:1px solid var(--g1);transition:all .5s;cursor:pointer;position:relative;overflow:hidden}
.why-card:last-child{border-right:none}
.why-card__header{padding:2.2rem;position:relative;z-index:2;transition:all .5s}
.why-card:hover .why-card__header{background:var(--cr)}
.why-card__icon{color:var(--aul);margin-bottom:1.2rem;opacity:.7;transition:transform .4s}
.why-card:hover .why-card__icon{transform:translateY(-2px)}
.why-card__title{font-size:1.15rem;font-weight:400;color:var(--g);margin-bottom:.7rem;display:flex;align-items:center;gap:.8rem}
.why-card__title-arrow{color:var(--au);opacity:.5;transition:all .4s;width:16px;height:16px}
.why-card:hover .why-card__title-arrow{opacity:1;transform:rotate(180deg)}
.why-card__desc{font-size:.78rem;line-height:1.8;color:var(--g5);font-weight:300}
.why-card__panel{max-height:0;overflow:hidden;transition:max-height .7s cubic-bezier(.16,1,.3,1),opacity .5s;opacity:0;background:var(--w)}
.why-card:hover .why-card__panel{max-height:600px;opacity:1}
.why-card__panel-inner{padding:0 2.2rem 2.2rem;display:flex;flex-direction:column;gap:1.2rem}
.why-card__images{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}
.why-card__images.single{grid-template-columns:1fr}
.why-card__img{border-radius:4px;overflow:hidden;position:relative;border:1px solid var(--g1)}
.why-card__img img{width:100%;height:150px;display:block;opacity:.9;transition:opacity .3s;object-fit:cover;}
.why-card__img:hover img{opacity:1}
.why-card__img-caption{font-size:.65rem;color:var(--g5);padding:.5rem .7rem;background:var(--cr);font-weight:400;letter-spacing:.03em}
.why-card__detail{font-size:.72rem;line-height:1.7;color:var(--g5);font-weight:300;border-top:1px solid var(--g1);padding-top:1rem}

/* ========== PHASE TIMELINE ========== */
.hero__ph{position:relative;z-index:3;max-width:1400px;margin:0 auto;padding:1.5rem 4vw 5rem;opacity:0;transform:translateY(30px);animation:fu 1s 1.1s forwards}
.ph__lab{font-size:10px;font-weight:600;letter-spacing:.3em;text-transform:uppercase;color:var(--au);margin-bottom:2rem;display:flex;align-items:center;gap:1rem}
.ph__lab::before{content:'';width:2rem;height:1px;background:var(--au)}
.ph__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border:1px solid var(--g1)}
.ph-c{padding:2.2rem;border-right:1px solid var(--g1);position:relative;transition:all .5s;cursor:default}
.ph-c:last-child{border-right:none}
.ph-c:hover{background:var(--cr)}
.ph-c__st{display:inline-block;font-size:9px;font-weight:600;letter-spacing:.15em;text-transform:uppercase;padding:4px 12px;border-radius:2px;margin-bottom:1.2rem}
.ph-c__st--a{background:rgba(176,141,59,.2);color:var(--aul)}
.ph-c__st--p{background:var(--g1);color:var(--g5)}
.ph-c__num{font-size:2.8rem;font-weight:300;color:var(--g);line-height:1;margin-bottom:.2rem}
.ph-c__unit{font-size:.9rem;font-weight:300;color:var(--g3);margin-bottom:1.2rem}
.ph-c__title{font-size:1.15rem;font-weight:400;color:var(--g);margin-bottom:.6rem}
.ph-c__desc{font-size:.78rem;line-height:1.8;color:var(--g5);font-weight:300}
.ph-c__bar{position:absolute;bottom:0;left:0;height:2px;background:var(--au)}
.hero__sc{position:absolute;bottom:3vh;right:4vw;z-index:3;display:flex;flex-direction:column;align-items:center;gap:.8rem;opacity:0;animation:fu 1s 1.4s forwards}
.hero__sc span{font-size:9px;letter-spacing:.25em;text-transform:uppercase;color:var(--g3);writing-mode:vertical-rl;font-weight:500}
.hero__sc-l{width:1px;height:60px;background:linear-gradient(to bottom,var(--au),transparent);animation:sp 2s ease-in-out infinite}

@keyframes sp{0%,100%{opacity:1;transform:scaleY(1)}50%{opacity:.4;transform:scaleY(.6);transform-origin:top}}
@keyframes fu{to{opacity:1;transform:translateY(0)}}

/* ========== COMMON SECTIONS ========== */
.sec{padding:10rem 4vw}
.sec--d{background:var(--gd);color:var(--w)}.sec--c{background:var(--cr)}.sec--w{background:var(--w)}.sec--wm{background:var(--crw)}
.sec__in{max-width:1400px;margin:0 auto}
.ey{font-size:10px;font-weight:600;letter-spacing:.3em;text-transform:uppercase;color:var(--au);margin-bottom:1.5rem;display:flex;align-items:center;gap:1rem}
.ey::before{content:'';width:2rem;height:1px;background:var(--au)}
.st{font-size:clamp(2rem,4vw,3.8rem);font-weight:300;line-height:1.2;margin-bottom:2rem}
.sd{font-size:1rem;font-weight:300;line-height:1.9;color:var(--g5);max-width:600px}
.sec--d .sd{color:rgba(255,255,255,.55)}

/* スクロールアニメーション（安全装置付き） */
.rv{transition:all .9s cubic-bezier(.16,1,.3,1)}
.rv.v{opacity:1 !important;transform:translateY(0) !important}

.bov{display:grid;grid-template-columns:1fr 1fr;gap:0}
.bov__l{padding:6rem 4rem;display:flex;flex-direction:column;justify-content:center}
.bov__r{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;gap:1px;background:var(--g1)}
.bc{background:var(--w);padding:2.5rem;display:flex;flex-direction:column;transition:all .4s;cursor:default;position:relative;overflow:hidden}
.bc:hover{background:var(--cr)}
.bc::before{content:'';position:absolute;top:0;left:0;width:100%;height:2px;background:var(--au);transform:scaleX(0);transform-origin:left;transition:transform .5s cubic-bezier(.16,1,.3,1)}
.bc:hover::before{transform:scaleX(1)}
.bc__ic{color:var(--au);margin-bottom:1.5rem}
.bc__t{font-size:1.2rem;font-weight:400;color:var(--g);margin-bottom:.8rem}
.bc__d{font-size:.8rem;line-height:1.8;color:var(--g5);font-weight:300;margin-top:auto}
.bov__tag{font-size:clamp(1.8rem,3vw,2.8rem);font-weight:300;line-height:1.4;color:var(--g);margin-bottom:2rem}
.bov__body{font-size:.9rem;font-weight:300;line-height:2;color:var(--g5);margin-bottom:2.5rem;max-width:480px}
.bov__ms{font-size:.8rem;font-weight:400;line-height:1.8;color:var(--g);padding-left:1.5rem;border-left:2px solid var(--au);font-style:italic}
.vis__g{display:grid;grid-template-columns:1fr 1fr;gap:6rem;align-items:center}
.vis__img{position:relative;overflow:hidden;aspect-ratio:4/5}
.vis__img img{width:100%;height:100%;object-fit:cover;filter:grayscale(30%);transition:transform 1.5s cubic-bezier(.16,1,.3,1),filter 1s}
.vis__img:hover img{transform:scale(1.04);filter:grayscale(0%)}
.vis__img-ov{position:absolute;inset:0;background:linear-gradient(to top,var(--gd),transparent 40%);opacity:.3;pointer-events:none}
.vis__stats{display:grid;grid-template-columns:1fr 1fr;gap:2rem;margin-top:3rem;padding-top:3rem;border-top:1px solid var(--g1)}
.sn{font-size:2.8rem;font-weight:300;color:var(--g);line-height:1;margin-bottom:.5rem}
.sl{font-size:11px;letter-spacing:.12em;color:var(--g5);font-weight:400}
.lg{display:grid;grid-template-columns:repeat(3,1fr);gap:2px;margin-top:5rem}
.lc{padding:3.5rem 2rem;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.06);transition:all .5s;display:flex;flex-direction:column;align-items:center}
.lc:hover{background:rgba(255,255,255,.08);border-color:var(--au)}
.lc > div{width:100%;max-width:260px;text-align:left}
.lc__img{aspect-ratio:1/1;border-radius:16px;overflow:hidden;margin-bottom:1.5rem;border:1px solid rgba(255,255,255,.15)}
.lc__img img{width:100%;height:100%;object-fit:cover;display:block}
.lc__r{font-size:13px;letter-spacing:.15em;text-transform:uppercase;color:var(--au);margin-bottom:.3rem;font-weight:600}
.lc__n{font-size:1.8rem;font-weight:400;color:var(--w);margin-bottom:1.2rem}
.lc__d{font-size:.85rem;line-height:1.8;color:var(--w);font-weight:300}
.svh{display:grid;grid-template-columns:1fr 1fr;gap:6rem;margin-bottom:6rem;align-items:end}
.svg2{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--g1)}
.svc{background:var(--w);padding:3rem;transition:all .5s;cursor:default;position:relative;overflow:hidden}
.svc::before{content:'';position:absolute;top:0;left:0;width:100%;height:2px;background:var(--au);transform:scaleX(0);transform-origin:left;transition:transform .6s cubic-bezier(.16,1,.3,1)}
.svc:hover::before{transform:scaleX(1)}.svc:hover{background:var(--cr)}
.svc__ic{color:var(--au);margin-bottom:2rem;transition:transform .4s}
.svc:hover .svc__ic{transform:translateY(-4px)}
.svc__t{font-size:1.4rem;font-weight:400;color:var(--g);margin-bottom:1rem}
.svc__d{font-size:.85rem;line-height:1.8;color:var(--g5);font-weight:300}
.pf{display:grid;grid-template-columns:1fr 1fr;gap:2rem;margin-bottom:6rem}
.pc{position:relative;overflow:hidden;background:var(--gd);cursor:default;height:520px}
.pc::before{content:'';position:absolute;inset:0;background:rgba(128,128,128,0.4);z-index:1;pointer-events:none;transition:all 1.5s cubic-bezier(.16,1,.3,1)}
.pc:hover::before{background:rgba(128,128,128,0.2)}
.pc__img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.5;filter:grayscale(60%);transition:all 1.5s cubic-bezier(.16,1,.3,1);z-index:0}
.pc:hover .pc__img{opacity:0;visibility:hidden}
.pc__video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;visibility:hidden;transition:all 1s cubic-bezier(.16,1,.3,1);z-index:0}
.pc:hover .pc__video{opacity:.65;visibility:visible;transform:scale(1.06)}
.pc__ov{position:absolute;bottom:0;left:0;right:0;padding:3rem;background:linear-gradient(to top,rgba(6,31,20,.95) 0%,transparent 100%);z-index:2}
.pc__ph{font-size:10px;letter-spacing:.3em;text-transform:uppercase;color:var(--au);font-weight:600;margin-bottom:.8rem}
.pc__t{font-size:2rem;font-weight:300;color:var(--w);margin-bottom:.5rem}
.pc__s{font-size:.85rem;color:rgba(255,255,255,.5);font-weight:300}
.pl{border-top:1px solid var(--g1);padding-top:4rem}
.plh{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:3rem}
.plt{font-size:1.6rem;font-weight:400;color:var(--g)}
.pld{font-size:.85rem;color:var(--g5);font-weight:300;max-width:500px;text-align:right;line-height:1.7}
.pi{display:flex;align-items:center;gap:1.5rem;padding:1.5rem 0;border-bottom:1px solid var(--g1);transition:all .3s;cursor:default;text-decoration:none}
.pi:hover{padding-left:1rem;border-color:var(--au)}
.pi__n{font-size:1.4rem;color:var(--au);font-weight:300;min-width:2rem}
.pi__nm{font-size:.9rem;color:var(--ch);font-weight:400;letter-spacing:.02em}
.pi__ar{margin-left:auto;color:var(--au);opacity:0;transform:translate(-8px,8px);transition:all .4s}
.pi:hover .pi__ar{opacity:1;transform:translate(0,0)}

/* ========== CONTACT SECTION ========== */
.ctg{display:grid;grid-template-columns:3fr 2fr;gap:6rem}
.ctf{display:flex;flex-direction:column;gap:2.5rem}
.fr{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-bottom:1.5rem} 
.ff{position:relative}
.ff input,.ff textarea{width:100%;background:transparent;border:none;border-bottom:1px solid var(--g3);padding:1rem 0;font-size:.9rem;font-weight:300;color:var(--ch);transition:border-color .3s;outline:none;resize:none}
.ff input:focus,.ff textarea:focus{border-color:var(--au)}
.ff input::placeholder,.ff textarea::placeholder{color:var(--g3);font-weight:300}
.ff--radio{margin-top:1rem}
.ff--radio-label{font-size:0.9rem; color:var(--g3); margin-bottom:1rem; display:block; font-weight:300}
.ff--radio-group{display:flex; gap:2.5rem}
.ff--radio-item{display:flex; align-items:center; gap:0.6rem; cursor:pointer; color:var(--ch); font-weight:300; font-size:0.95rem}
.ff--radio-item input[type="radio"]{accent-color:var(--au); width:18px; height:18px; cursor:pointer}
.sbtn{display:inline-flex;align-items:center;gap:1.5rem;background:none;border:none;cursor:pointer;font-size:11px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--g);transition:color .3s;padding:0;margin-top:1rem}
.sbtn:hover{color:var(--au)}
.sbtn__l{width:3rem;height:1px;background:var(--g);transition:all .4s}
.sbtn:hover .sbtn__l{width:4rem;background:var(--au)}
.cti{background:var(--gd);padding:3.5rem;display:flex;flex-direction:column;justify-content:space-between}
.cti__lb{font-size:10px;letter-spacing:.25em;text-transform:uppercase;color:var(--au);font-weight:600;margin-bottom:2rem;padding-bottom:1.5rem;border-bottom:1px solid rgba(255,255,255,.08)}
.cti__ad{font-size:.9rem;line-height:2;color:rgba(255,255,255,.55);font-weight:300}
.cti__sc{display:flex;gap:1.5rem;margin-top:3rem}
.cti__sc a{color:var(--au);transition:color .3s}.cti__sc a:hover{color:var(--w)}

/* ========== FOOTER ========== */
.ft{background:var(--gd);padding:6rem 4vw 3rem;border-top:1px solid rgba(255,255,255,.06)}
.ft__in{max-width:1400px;margin:0 auto}
.ft__top{display:flex;justify-content:space-between;align-items:flex-start;padding-bottom:4rem;border-bottom:1px solid rgba(255,255,255,.06);margin-bottom:3rem}
.ft__cta{font-size:clamp(1.5rem,2.5vw,2.2rem);font-weight:300;color:rgba(255,255,255,.7);line-height:1.5;max-width:500px}
.ft__nav{display:flex;flex-direction:column;gap:1.2rem;text-align:right}
.ft__nav a{ position: relative; display: inline-flex; flex-direction: column; overflow: hidden; font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: rgba(255,255,255,.35); text-decoration: none; font-weight: 500; transition: color .3s; }
.ft__nav a span { transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s; }
.ft__nav a::before { content: attr(data-ja); position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: flex-end; font-family: 'DM Sans', 'Noto Sans JP', sans-serif; font-size: 10px; font-weight: 500; color: var(--au); transform: translateY(25px); opacity: 0; transition: opacity 0.4s, transform 0.4s cubic-bezier(.16,1,.3,1); }
.ft__nav a span:hover { color: #C9A227; }
.ft__nav a:hover span { opacity: 0; transform: translateY(-25px); }
.ft__nav a:hover::before { opacity: 1; transform: translateY(0); }
.ft__bot{display:flex;justify-content:space-between;align-items:center;font-size:11px;color:rgba(255,255,255,.25);font-weight:300}
.ft__bot a{color:rgba(255,255,255,.25);text-decoration:none;margin-left:2rem;transition:color .3s}
.ft__bot a:hover{color:rgba(255,255,255,.6)}

/* ========== RESPONSIVE ========== */
@media(max-width:1024px){
.sec{padding:6rem 6vw}.vis__g{grid-template-columns:1fr;gap:3rem}.vis__img{aspect-ratio:16/9;order:-1}
.bov{grid-template-columns:1fr}.bov__l{padding:4rem 6vw}.svh{grid-template-columns:1fr;gap:2rem}
.svg2{grid-template-columns:repeat(2,1fr)}.lg{grid-template-columns:1fr;gap:1px}
.pf{grid-template-columns:1fr}.pc{height:400px}.ctg{grid-template-columns:minmax(0,1fr)}.ctg>*{min-width:0}
.ft__top{flex-direction:column;gap:3rem}.ft__nav{text-align:left}.ft__nav a::before{justify-content:flex-start}
.plh{flex-direction:column;gap:1rem}.pld{text-align:left}
.why__grid,.ph__grid{grid-template-columns:1fr}
.why-card{border-right:none;border-bottom:1px solid var(--g1)}
.why-card:last-child{border-bottom:none}
.why-card__images{grid-template-columns:1fr}
.ph-c{border-right:none;border-bottom:1px solid var(--g1)}
.ph-c:last-child{border-bottom:none}
}
@media(max-width:768px){
.nav__ls{display:none}.ham{display:block}.sec{padding:5rem 24px}
/* ★ スマホ：画面端に文字が寄り過ぎないよう左右余白を24pxに統一 */
.nav__i{padding:1.5rem 24px}.nav--s .nav__i{padding:1rem 24px}
.hero__c{padding:0 24px}
.hero__up,.hero__why,.hero__ph{padding-left:24px !important;padding-right:24px !important}
.ft{padding-left:24px;padding-right:24px}
.ff--radio-group{flex-wrap:wrap;gap:1rem 2rem}
.svg2{grid-template-columns:1fr}.fr{grid-template-columns:1fr}
.hero__up{padding-top:14vh}.hero__sc{display:none}
.vis__stats{grid-template-columns:1fr 1fr;gap:1.5rem}
.ft__bot{flex-direction:column;gap:1rem;text-align:center}
.ft__bot a{margin-left:0;margin-right:1rem}
.bov__r{grid-template-columns:1fr}
}
</style>
</head>
<body>
<slot />

<script is:inline>
try { lucide.createIcons(); } catch(e) {}
try {
  const nav=document.getElementById('nav');
  if(nav) window.addEventListener('scroll',()=>nav.classList.toggle('nav--s',window.scrollY>60));
  const ham=document.getElementById('ham'),mm=document.getElementById('mm');
  if(ham && mm){
    ham.addEventListener('click',()=>{ham.classList.toggle('open');mm.classList.toggle('open');document.body.style.overflow=mm.classList.contains('open')?'hidden':''});
    window.cm = function(){ham.classList.remove('open');mm.classList.remove('open');document.body.style.overflow=''};
  }
} catch(e) {}
try {
  const rvs = document.querySelectorAll('.rv');
  if(window.IntersectionObserver){
    rvs.forEach(el => { el.style.opacity = '0'; el.style.transform = 'translateY(40px)'; });
    setTimeout(() => {
      const obs = new IntersectionObserver(es=>{es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('v');obs.unobserve(e.target)}})},{threshold:.08,rootMargin:'0px 0px -40px 0px'});
      rvs.forEach(el=>obs.observe(el));
    }, 100);
  }
} catch(e) {}

// プロジェクトセクションの動画再生・停止
function playVideo(el) { try{ const video = el.querySelector('video'); if (video) video.play(); } catch(e){} }
function pauseVideo(el) { try{ const video = el.querySelector('video'); if (video) { video.pause(); video.currentTime = 0; } } catch(e){} }
window.playVideo = playVideo;
window.pauseVideo = pauseVideo;
</script>
</body>
