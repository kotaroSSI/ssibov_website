---
import { dict, makeL, localizeNews, type Lang } from '../../i18n';
import LangSwitch from '../LangSwitch.astro';

interface Props { lang?: Lang }
const { lang = 'ja' } = Astro.props as Props;
const t = dict('project', lang);
const L = makeL(lang);
const PATH = '/project/';

import Layout from '../../layouts/Layout.astro';
import News from '../news.astro';
import Aboutksdi from '../aboutksdi.astro';
import Services from '../services.astro';
import Contact from '../contact.astro';

// ===== SEO：検索結果の表示（タイトル・説明文）と構造化データ =====
const pageTitle = t.meta_title;
const pageDesc  = t.meta_desc;
const orgLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "凱信数基株式会社",
  "alternateName": ["Kai Shin Digital Infrastructure Inc.", "凱信数基", "Kaishin Digital Infrastructure"],
  "url": "https://ssibov.com/project/",
  "logo": "https://ssibov.com/logo/Kaishin_Geometric_Logo.png",
  "description": pageDesc,
  "foundingDate": "2026-01-20",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "サーキュラーパーク一丁目1番地",
    "addressLocality": "薩摩川内市",
    "addressRegion": "鹿児島県",
    "addressCountry": "JP"
  },
  "areaServed": "JP",
  "knowsAbout": ["AIデータセンター", "GPU計算基盤", "脱炭素電力", "薩摩川内", "鹿児島"]
};
---

<Layout lang={lang} path={PATH} title={pageTitle} description={pageDesc}>
<script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(orgLd)} />

<style is:global>
  /* ========================================================= */
  /* 全体設定 */
  /* ========================================================= */
  :root {
    --au: #b08d3b; /* SSIゴールド */
    --g: #333;   /* ダークグレー */
    --w: #fff;   /* ホワイト */
  }

  /* ★ 固定ヘッダーの高さ分、アンカーリンクのスクロール位置を補正 */
  html { scroll-padding-top: 90px; }

  .hero__up {
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
    padding-top: 8rem !important; 
    padding-bottom: 2rem;
    padding-left: 4vw;   /* ★ hero__c ラッパーが無いため左右余白をここで確保 */
    padding-right: 4vw;
    text-align: left;
  }
  
  /* ========================================================= */
  /* ★ タイトルの調整（フォントサイズ縮小と表示スペース拡大） */
  /* ========================================================= */
  .hero__t {
    font-size: 2.2rem !important; /* フォントサイズを縮小 */
    white-space: nowrap; /* 意図しない途中改行を防止 */
    line-height: 1.5 !important;
  }
  .st {
    font-size: 1.8rem !important; /* セクションタイトルのフォントサイズを縮小 */
    white-space: nowrap; /* 意図しない途中改行を防止 */
    line-height: 1.5 !important;
  }
  
  /* ★ Visionセクション：グリッド列比率でテキストエリアを広げる
     （.vis__gはLayout側でdisplay:gridのため、flex指定は効かず左列が過度に狭くなっていた） */
  @media (min-width: 1025px) {
    .vis__g { grid-template-columns: 1.15fr 1fr !important; gap: 4rem !important; }
  }

  /* ★ 中間幅(タブレット・小型ノートPC)でのタイトルはみ出し防止 */
  @media (max-width: 1100px) {
    .hero__t, .st { white-space: normal !important; }
  }

  /* スマホ閲覧時は画面外へのはみ出しを防ぐため折り返しを許可 */
  @media (max-width: 768px) {
    .hero__t { font-size: 1.4rem !important; white-space: normal; }
    .st { font-size: 1.4rem !important; white-space: normal; }
  }

  /* ========================================================= */
  /* アコーディオン設定（EPCページと同一フォーマット：ホバーで下方向に展開） */
  /* ベースのスタイルはLayout.astro側の定義をそのまま使用 */
  /* ========================================================= */
  .why-card {
    cursor: pointer;
  }
  .why-card__panel {
    max-height: 0 !important;
    opacity: 0 !important;
    visibility: hidden !important;
    overflow: hidden !important;
    margin-top: 0 !important;
    transition: max-height 0.6s ease, opacity 0.6s ease, margin-top 0.6s ease !important;
  }
  .why-card:hover .why-card__panel {
    max-height: 2000px !important; /* コンテンツ全体が収まる十分な高さ */
    opacity: 1 !important;
    visibility: visible !important;
    margin-top: 1.5rem !important;
  }
  .why-card__title-arrow {
    display: none !important;
  }

  /* ========================================================= */
  /* アコーディオン内の画像を上下30%伸ばす（縦幅拡張／EPCと同一） */
  /* ========================================================= */
  .why-card__images .why-card__img img {
    width: 100% !important;
    height: auto !important;
    /* 通常の16:9比率から、高さを30%アップさせた比率(16:11.7)に設定 */
    aspect-ratio: 16 / 11.7 !important;
    object-fit: cover !important;
  }

  /* ========================================================= */
  /* ★ Hero動画の余白解消 */
  /* ========================================================= */
  .hero__video {
    width: 100%;
    max-width: 1000px;
    aspect-ratio: 20 / 9; /* ★ スクリーン比率を20:9に設定 */
    overflow: hidden;
    position: relative;
    border-radius: 8px;
    border: 1px solid rgba(0,0,0,0.1);
  }
  .hero__video video {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    height: 100%;
    width: auto;
    aspect-ratio: 22 / 9; /* ★ 動画に焼き込まれた上下の黒帯をトリミングして表示 */
    object-fit: cover;    /* ★ 上下の黒い線を見えなくする */
  }

  /* ========================================================= */
  /* PROJECT ROADMAP */
  /* ========================================================= */
  .hero__ph { width: 100%; max-width: 1000px; margin: 4rem auto 0; text-align: left; }
  .ph__lab { display: flex; align-items: center; margin-bottom: 2rem; }
  .ph__lab::before { display: none !important; } /* ★ Layout側の線と重複するため非表示（線を1本に） */
  .ph__lab-line { width: 40px; height: 1px; background-color: var(--au); margin-right: 1rem; }
  .ph__lab-text { color: var(--au); font-size: 0.85rem; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 600; }
  
  .ph__container { background-color: #ffffff; border: 1px solid rgba(0,0,0,0.1); border-radius: 2px; padding: 4rem 2rem 0; display: flex; flex-direction: column; }
  .ph__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0; justify-items: stretch; } /* ★ 350と1,000の2枚を中央に均等配置 */
  .ph-c { position: relative; padding: 0 2.5rem 4rem; display: flex; flex-direction: column; align-items: flex-start; border-right: 1px solid #eee; } /* ★ 2枚構成に合わせ左右余白を拡大 */
  .ph-c:last-child { border-right: none; }
  .ph-c__st { display: inline-block; font-size: 10px; font-weight: 600; letter-spacing: .15em; text-transform: uppercase; padding: 4px 12px; border-radius: 2px; margin-bottom: 1.2rem; }
  .ph-c__st--a { background: rgba(176,141,59,.1); color: var(--au); }
  .ph-c__st--p { background: #f0f0f0; color: #888; }
  .ph-c__num { font-size: 3rem; font-weight: 300; color: var(--g); line-height: 1; margin-bottom: .2rem; }
  .ph-c__unit { font-size: 1rem; font-weight: 300; color: #aaa; margin-bottom: 1.2rem; font-family: 'DM Sans', sans-serif; }
  .ph-c__title { font-size: 1.15rem; font-weight: 400; color: var(--g); margin-bottom: .6rem; font-family: 'Noto Serif JP', serif; }
  .ph-c__desc { font-size: 0.85rem; line-height: 1.7; color: #666; font-weight: 300; margin-bottom: 2rem; }
  .ph-c__bar { position: absolute; bottom: 0; left: 0; height: 3px; background: var(--au); }

  @media (max-width: 768px) {
    .ph__grid { grid-template-columns: 1fr; }
    .ph-c { border-right: none; border-bottom: 1px solid #eee; }
  }

  /* ========================================================= */
  /* VISIONセクション：動画の位置 */
  /* ========================================================= */
  .vis__img {
    position: relative;
    overflow: hidden;
  }
  .vis__img video {
    position: absolute;
    bottom: 0;
    right: -15%;
    width: 115%;
    height: 100%;
    object-fit: cover;
    object-position: right bottom;
  }
</style>

<header class="nav" id="nav">
  <div class="nav__i">
    <a href={L("/")} class="nav__logo"><img src="/logo/Kaishin_Geometric_Logo.png" alt={t.nav_001}/></a>
    <nav class="nav__ls">
      <a href="#vision" class="nav__l" data-ja={t.nav_002}><span>VISION</span></a>
      <a href="#about" class="nav__l" data-ja={t.nav_003}><span>ABOUT US</span></a>
      <a href="#services" class="nav__l" data-ja={t.nav_004}><span>SERVICE</span></a>
      <a href="#projects" class="nav__l" data-ja={t.nav_005}><span>PROJECT</span></a>
      <a href="#contact" class="nav__l" data-ja={t.nav_006} style="text-align:center; line-height:1.2;"><span>CONSTRUCTION<br>REQUEST</span></a>
    </nav>
    <LangSwitch lang={lang} path={PATH} />
<button class="ham" id="ham" aria-label={t.nav_007}><span></span><span></span><span></span></button>
  </div>
</header>

<div class="mmenu" id="mm">
  <a href="#vision" onclick="cm()" data-ja={t.nav_008}><span>VISION</span></a>
  <a href="#about" onclick="cm()" data-ja={t.nav_009}><span>ABOUT US</span></a>
  <a href="#services" onclick="cm()" data-ja={t.nav_010}><span>SERVICE</span></a>
  <a href="#projects" onclick="cm()" data-ja={t.nav_011}><span>PROJECT</span></a>
  <a href="#contact" onclick="cm()" data-ja={t.nav_012} style="text-align:center; line-height:1.1;"><span>CONSTRUCTION<br>REQUEST</span></a>
<LangSwitch lang={lang} path={PATH} />
</div>

<section class="hero">
  <div class="hero__up">
    <p class="hero__ey">{t.nav_013}</p>
    <!-- ★ メインコピーのテキスト変更 -->
    <h1 class="hero__t"><Fragment set:html={t.nav_014} /></h1>
    <p class="hero__sub">{t.nav_015}</p>
    <div class="hero__video">
      <!-- ★ loop属性なし、Endedイベントで切り替え -->
      <video id="hero-video" src="/movie/movie0001.mp4" autoplay muted playsinline></video>
    </div>
  </div>

  <!-- ★ EPCページと同じ「なぜ」アコーディオンブロック -->
  <div class="hero__why">
  <div class="why__grid">
  <div class="why-card">
  <div class="why-card__header">
    <div class="why-card__icon"><i data-lucide="zap" style="width:24px;height:24px"></i></div>
    <div class="why-card__title">{t.nav_016}</div>
    <div class="why-card__desc">{t.nav_017}</div>
  </div>
  <div class="why-card__panel"><div class="why-card__panel-inner">
  <div class="why-card__images">
    <div class="why-card__img"><img src="/image/image0001.jpg" alt={t.nav_018}/><div class="why-card__img-caption">{t.nav_019}</div></div>
    <div class="why-card__img"><img src="/image/image0002.jpg" alt={t.nav_020}/><div class="why-card__img-caption">{t.nav_021}</div></div>
    <div class="why-card__img"><img src="/image/image0003.jpg" alt={t.nav_022}/><div class="why-card__img-caption">{t.nav_023}</div></div>
  </div>
  <div class="why-card__detail">
    {t.nav_024}
  </div>
  </div></div>
  </div>
  <div class="why-card">
  <div class="why-card__header">
    <div class="why-card__icon"><i data-lucide="brain" style="width:24px;height:24px"></i></div>
    <div class="why-card__title">{t.nav_025}</div>
    <div class="why-card__desc">{t.nav_026}</div>
  </div>
  <div class="why-card__panel"><div class="why-card__panel-inner">
  <div class="why-card__images">
    <div class="why-card__img"><img src="/image/image0004.jpg" alt={t.nav_027}/><div class="why-card__img-caption">{t.nav_028}</div></div>
    <div class="why-card__img"><img src="/image/image0005.jpg" alt={t.nav_029}/><div class="why-card__img-caption">{t.nav_030}</div></div>
    <div class="why-card__img"><img src="/image/image0006.jpg" alt={t.nav_031}/><div class="why-card__img-caption">{t.nav_032}</div></div>
  </div>
  <div class="why-card__detail">
    {t.nav_033}
  </div>
  </div></div>
  </div>
  <div class="why-card">
  <div class="why-card__header">
    <div class="why-card__icon"><i data-lucide="shield" style="width:24px;height:24px"></i></div>
    <div class="why-card__title">{t.nav_034}</div>
    <div class="why-card__desc">{t.nav_035}</div>
  </div>
  <div class="why-card__panel"><div class="why-card__panel-inner">
  <div class="why-card__images">
    <div class="why-card__img"><img src="/image/image0007.jpg" alt={t.nav_036}/><div class="why-card__img-caption">{t.nav_037}</div></div>
    <div class="why-card__img"><img src="/image/image0008.jpg" alt={t.nav_038}/><div class="why-card__img-caption">{t.nav_039}</div></div>
    <div class="why-card__img"><img src="/image/image0009.jpg" alt={t.nav_040}/><div class="why-card__img-caption">{t.nav_041}</div></div>
  </div>
  <div class="why-card__detail">
    {t.nav_042}
  </div>
  </div></div>
  </div>
  </div>
  </div>

  <div class="hero__ph" id="projects">
    <div class="ph__lab">
      <span class="ph__lab-line"></span>
      <span class="ph__lab-text">PROJECT ROADMAP</span>
    </div>
    <div class="ph__container">
      <div class="ph__grid">
        <div class="ph-c">
          <span class="ph-c__st ph-c__st--a">{t.nav_043}</span>
          <div class="ph-c__num">350</div>
          <div class="ph-c__unit">MW — Phase 1</div>
          <div class="ph-c__title">{t.nav_044}</div>
          <div class="ph-c__desc">{t.nav_045}</div>
          <div class="ph-c__bar" style="width:20%;"></div>
        </div>
        <div class="ph-c">
          <span class="ph-c__st ph-c__st--p">{t.nav_046}</span>
          <div class="ph-c__num">1,000</div>
