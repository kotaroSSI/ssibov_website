---
import Layout from '../layouts/Layout.astro';
import newsData from '../data/news.json';

// 日付の新しい順に並べ替え、最新5件を表示
const newsList = [...newsData]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 5);
---

<Layout title="信越科学産業株式会社 | EPC — AI Infrastructure">

<style is:global>
  /* ========================================================= */
  /* ヘッダー・ロゴはProjectページと同一（Layout.astroの既定値をそのまま使用） */
  /* ========================================================= */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 72.5px !important;
  }
  .hero__up {
    padding-top: 0 !important;
    padding-bottom: 2rem;
  }

  /* ========================================================= */
  /* ★ ヒーロー文字サイズの適正化（Layout既定のclampは過大なため縮小） */
  /* ========================================================= */
  .hero__t {
    font-size: clamp(1.8rem, 2.8vw, 2.8rem) !important;
    line-height: 1.5 !important;
  }
  /* 2行目（ゴールドの補足コピー）は一段小さくして階層をつける */
  .hero__t em {
    display: block;
    font-size: 0.6em;
    margin-top: 0.5rem;
    letter-spacing: 0.02em;
  }
  .hero__sub {
    max-width: none !important; /* ★ 手動改行(br)で整形するため幅制限を解除 */
  }
  @media (max-width: 768px) {
    .hero__t { font-size: 1.4rem !important; }
    .hero__sub br { display: none; } /* ★ スマホでは自然な折り返しに戻す */
  }

  /* ========================================================= */
  /* ★ ページ全体のタイポグラフィ階層調整 */
  /* ヒーロー(最大2.8rem)を頂点に、セクション見出し→カード見出し→本文の */
  /* 順で段階的に小さくなるようサイズを統一 */
  /* ========================================================= */
  .st {
    font-size: clamp(1.6rem, 2.4vw, 2.4rem) !important; /* セクション見出し（Layout既定の最大3.8remはヒーローより大きく逆転していたため縮小） */
  }
  .lc__n {
    font-size: 1.5rem !important; /* 経営陣の氏名（1.8rem→カード見出し級に統一） */
  }
  .ph-c__num {
    font-size: 2.6rem !important; /* ロードマップの数字（ヒーロー見出しを超えないサイズに） */
  }

  /* ========================================================= */
  /* ★ PROJECT ROADMAP：Phase 1削除に伴い350/1,000の2枚を中央に均等配置 */
  /* ========================================================= */
  .ph__grid {
    grid-template-columns: repeat(2, 1fr) !important;
  }
  .ph-c {
    padding: 2.2rem 2.5rem !important; /* 2枚構成に合わせ左右余白を拡大 */
  }
  @media (max-width: 1024px) {
    .ph__grid { grid-template-columns: 1fr !important; }
  }
  .hero__video video {
    aspect-ratio: 21.999999999999999999999999999999999999999999 / 9;
    object-fit: cover;
  }
  
  /* ホバー時の日本語サイズを英語と同じ(1em)に統一 */
  .nav__l::before, .mmenu a::before, .ft__nav a::before {
    white-space: nowrap !important;
    font-size: 1em !important; 
  }
  
  .vis__img video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(30%);
    transition: transform 1.5s cubic-bezier(.16,1,.3,1), filter 1s;
  }
  .vis__img:hover video {
    transform: scale(1.04);
    filter: grayscale(0%);
  }

  /* ========================================================= */
  /* 「なぜ鹿児島か」等の説明をホバー時に展開する仕掛け */
  /* ========================================================= */
  .why-card {
    cursor: pointer;
  }
  .why-card__panel {
    max-height: 0 !important;
    opacity: 0 !important;
    visibility: hidden !important;
    overflow: hidden !important;
    margin-top: 0 !important;
    transition: max-height 0.6s ease, opacity 0.6s ease, margin-top 0.6s ease !important;
  }
  .why-card:hover .why-card__panel {
    max-height: 2000px !important; /* コンテンツ全体が収まる十分な高さ */
    opacity: 1 !important;
    visibility: visible !important;
    margin-top: 1.5rem !important;
  }
  .why-card__title-arrow {
    display: none !important; 
  }

  /* ========================================================= */
  /* アコーディオン内の画像を上下30%伸ばす（縦幅拡張） */
  /* ========================================================= */
  .why-card__images .why-card__img img {
    width: 100% !important;
    height: auto !important;
    /* 通常の16:9比率から、高さを30%アップさせた比率(16:11.7)に設定 */
    aspect-ratio: 16 / 11.7 !important; 
    object-fit: cover !important;
  }

  /* ========================================================= */
  /* PROJECTセクションのタイトル等の左寄せ設定 */
  /* ========================================================= */
  #projects .sec__in > .rv:first-child {
    text-align: left !important;
    margin-left: 0 !important;
  }
  #projects .ey {
    justify-content: flex-start !important;
  }

  /* ========================================================= */
  /* PROJECTセクションのカードデザイン（黒帯ズーム削除対応） */
  /* ========================================================= */
  .pf {
    display: grid !important;
    grid-template-columns: 1fr 1fr !important;
    gap: 2rem !important;
  }
  @media (max-width: 768px) {
    .pf {
      grid-template-columns: 1fr !important;
    }
  }

  .pc {
    width: 100% !important;
    aspect-ratio: 16 / 9 !important;
    background-color: #2b3b36 !important;
    position: relative !important;
    overflow: hidden !important; 
    border-radius: 4px;
  }

  .pc__video {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important; 
    transform: scale(1.35) !important;
    opacity: 0 !important;
    transition: opacity 0.6s ease !important;
    z-index: 1 !important;
  }

  .pc--left .pc__video {
    object-position: right center !important;
    transform-origin: right center !important;
  }

  .pc--right .pc__video {
    object-position: left center !important;
    transform-origin: left center !important;
  }

  .pc:hover .pc__video {
    opacity: 1 !important;
  }

  .pc__ov {
    position: absolute !important;
    top: auto !important; 
    bottom: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: auto !important; 
    padding: 2.5rem 2rem !important;
    z-index: 2 !important;
    opacity: 1 !important;
    background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0) 100%) !important;
    text-align: left !important;
  }
  .pc__ph {
    color: #cca45b !important;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
  }
  .pc__t {
    font-size: 1.6rem;
    color: #ffffff;
    margin-bottom: 0.5rem;
  }
  .pc__s {
    font-size: 0.9rem;
    color: #e0e0e0;
  }

  /* ========================================================= */
  /* フッターの英語文字サイズとカラー変更（分割設定） */
  /* ========================================================= */
  .ft__nav a {
    font-size: 14px !important; 
    color: #E6FFEF !important; 
  }
  .ft__bot span,
  .ft__bot a {
    font-size: 14px !important; 
    color: #E6FFEF !important; 
  }

  /* ========================================================= */
  /* モバイルメニュー/サイドメニューの英語文字サイズ */
  /* ========================================================= */
  .mmenu a span {
    font-size: 0.36em !important;
  }

  /* ========================================================= */
  /* TRACK RECORD（施工実績）セクション */
  /* ========================================================= */
  .tr-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 4rem;
  }
  @media (max-width: 900px) {
    .tr-grid { grid-template-columns: 1fr; }
  }
  .tr-card {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 4px;
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    transition: background 0.4s ease, transform 0.4s ease;
  }
  .tr-card:hover {
    background: rgba(255,255,255,0.09);
    transform: translateY(-4px);
  }
  .tr-card__tag {
    color: #cca45b;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    margin-bottom: 1.2rem;
  }
  .tr-card__num {
    font-family: 'DM Sans', sans-serif;
    font-size: 2.8rem;
    line-height: 1;
    color: #ffffff;
  }
  .tr-card__num span {
    font-size: 1.4rem;
    margin-left: 0.2rem;
  }
  .tr-card__t {
    color: #ffffff;
    font-size: 1.1rem;
    margin: 0.9rem 0 1rem;
    line-height: 1.6;
  }
  .tr-card__d {
    color: rgba(255,255,255,0.75);
    font-size: 0.9rem;
    line-height: 1.9;
  }
  .tr-partners {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid rgba(255,255,255,0.15);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2.5rem;
  }
  .tr-partners__lb {
    color: #cca45b;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
  }
  .tr-partner {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: #ffffff;
    border-radius: 4px;
    padding: 0.8rem 1.4rem;
  }
  .tr-partner img {
    height: 36px;
    width: auto;
    display: block;
  }
  .tr-partner__t {
    font-size: 0.8rem;
    color: #333333;
    line-height: 1.5;
  }
  .tr-note {
    margin-top: 2.5rem;
    color: rgba(255,255,255,0.85);
    font-size: 0.95rem;
    line-height: 2;
    max-width: 820px;
  }

  /* ========================================================= */
  /* FACILITY & POWER ENGINEERING（電力・冷却技術）セクション */
  /* ========================================================= */
  .fp-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 4rem;
  }
  @media (max-width: 900px) {
    .fp-grid { grid-template-columns: 1fr; }
  }
  .fp-card {
    background: #ffffff;
    border: 1px solid var(--g1);
    border-radius: 4px;
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.4s ease, transform 0.4s ease;
  }
  .fp-card:hover {
    box-shadow: 0 16px 32px rgba(0,0,0,0.08);
    transform: translateY(-4px);
  }
  .fp-card__tag {
    color: var(--au);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    margin-bottom: 1.2rem;
    text-transform: uppercase;
  }
  .fp-card__num {
    font-family: 'DM Sans', sans-serif;
    font-size: 2.8rem;
    line-height: 1;
    color: var(--g);
  }
  .fp-card__num span {
    font-size: 1.3rem;
    margin-left: 0.2rem;
  }
  .fp-card__t {
    color: var(--g);
    font-size: 1.1rem;
    margin: 0.9rem 0 1rem;
    line-height: 1.6;
  }
  .fp-card__d {
    color: #666;
    font-size: 0.9rem;
    line-height: 1.9;
  }
  .fp-ems {
    margin-top: 2rem;
    background: var(--gd);
    border-radius: 4px;
    padding: 2.8rem 2.5rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2rem;
    align-items: center;
  }
  @media (max-width: 900px) {
    .fp-ems { grid-template-columns: 1fr; }
  }
  .fp-ems__ic { color: var(--au); }
  .fp-ems__t {
    color: #ffffff;
    font-size: 1.15rem;
    margin-bottom: 0.8rem;
    font-family: 'Noto Serif JP', serif;
  }
  .fp-ems__d {
    color: rgba(255,255,255,0.8);
    font-size: 0.9rem;
    line-height: 1.9;
  }

  /* ========================================================= */
  /* NEXT-GEN GPU PLATFORMS（対応プラットフォーム）セクション */
  /* ========================================================= */
  .plt-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 4rem;
  }
  @media (max-width: 900px) {
    .plt-grid { grid-template-columns: 1fr; }
  }
  .plt-card {
    background: var(--w);
    border: 1px solid var(--g1);
    border-radius: 4px;
    padding: 2.5rem 2rem;
    position: relative;
    overflow: hidden;
    transition: box-shadow 0.4s ease;
  }
  .plt-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 2px;
    background: var(--au);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s cubic-bezier(.16,1,.3,1);
  }
  .plt-card:hover::before { transform: scaleX(1); }
  .plt-card:hover { box-shadow: 0 12px 30px rgba(0,0,0,0.06); }
  .plt-card__tag {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--au);
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .plt-card__t {
    font-size: 1.4rem;
    color: var(--g);
    margin-bottom: 0.4rem;
  }
  .plt-card__sub {
    font-size: 0.85rem;
    color: var(--g5);
    margin-bottom: 1.5rem;
    line-height: 1.7;
  }
  .plt-card__cool {
    border-top: 1px solid var(--g1);
    padding-top: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .plt-cool { display: flex; gap: 0.9rem; align-items: flex-start; }
  .plt-cool__badge {
    flex-shrink: 0;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border-radius: 2px;
    margin-top: 2px;
  }
  .plt-cool__badge--l { background: rgba(58,127,255,0.12); color: #2f66cc; }
  .plt-cool__badge--a { background: rgba(26,184,124,0.12); color: #178f62; }
  .plt-cool__d { font-size: 0.82rem; line-height: 1.7; color: var(--g5); }
  .mod-banner {
    margin-top: 3rem;
    background: var(--gd);
    border-radius: 4px;
    padding: 3rem 2.5rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2rem;
    align-items: center;
  }
  @media (max-width: 768px) {
    .mod-banner { grid-template-columns: 1fr; }
  }
  .mod-banner__ic { color: #cca45b; }
  .mod-banner__t { font-size: 1.4rem; color: #ffffff; margin-bottom: 0.6rem; }
  .mod-banner__d { font-size: 0.9rem; color: rgba(255,255,255,0.75); line-height: 1.9; }

  /* ========================================================= */
  /* GPU世代別ファシリティ要件 早見表 */
  /* ========================================================= */
  .gpu-tbl-wrap { margin-top: 3rem; overflow-x: auto; border: 1px solid var(--g1); border-radius: 4px; background:#fff; }
  .gpu-tbl { width: 100%; min-width: 760px; border-collapse: collapse; font-size: 0.85rem; }
  .gpu-tbl th, .gpu-tbl td { padding: 0.9rem 1.1rem; border-bottom: 1px solid var(--g1); text-align: left; vertical-align: top; line-height: 1.6; }
  .gpu-tbl thead th { background: var(--gd); color: #fff; font-weight: 400; font-size: 0.82rem; }
  .gpu-tbl thead th small { display:block; color: #cca45b; font-size: 0.72rem; margin-top: 2px; }
  .gpu-tbl tbody th { background: #f7f6f3; color: var(--g); font-weight: 600; white-space: nowrap; font-size: 0.8rem; }
  .gpu-tbl tbody td { color: #555; }
  .gpu-tbl tbody tr:last-child th, .gpu-tbl tbody tr:last-child td { border-bottom: none; }
  .gpu-tbl-note { margin-top: 1rem; font-size: 0.78rem; color: #999; line-height: 1.8; }

  /* サプライチェーン直結フロー */
  .sc-flow { margin-top: 3rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem; }
  .sc-flow__step { background: #fff; border: 1px solid var(--g1); border-radius: 4px; padding: 0.9rem 1.3rem; text-align: center; }
  .sc-flow__step--ssi { background: var(--gd); border-color: var(--gd); }
  .sc-flow__role { font-size: 0.68rem; letter-spacing: 0.12em; color: var(--au); text-transform: uppercase; margin-bottom: 0.25rem; }
  .sc-flow__name { font-size: 0.88rem; color: var(--g); line-height: 1.4; }
  .sc-flow__step--ssi .sc-flow__name { color: #fff; }
  .sc-flow__arrow { color: var(--au); flex-shrink: 0; }

  /* ========================================================= */
  /* EPCプロセス（横フロー） */
  /* ========================================================= */
  .proc-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1.2rem; margin-top: 4rem; }
  @media (max-width: 1100px) { .proc-grid { grid-template-columns: 1fr; } }
  .proc-step { position: relative; background: #fff; border: 1px solid var(--g1); border-radius: 4px; padding: 1.8rem 1.4rem; display: flex; flex-direction: column; }
  .proc-step__no { font-family: 'DM Sans', sans-serif; font-size: 0.78rem; letter-spacing: 0.15em; color: var(--au); margin-bottom: 0.8rem; }
  .proc-step__t { font-size: 1.02rem; color: var(--g); margin-bottom: 1rem; font-family: 'Noto Serif JP', serif; }
  .proc-step__lb { font-size: 0.7rem; letter-spacing: 0.1em; color: #999; text-transform: uppercase; margin-bottom: 0.4rem; }
  .proc-step__d { font-size: 0.8rem; color: #666; line-height: 1.8; margin-bottom: 1rem; }
  .proc-step__gpu { margin-top: auto; font-size: 0.78rem; color: var(--g); line-height: 1.7; background: rgba(176,141,59,0.08); border-left: 2px solid var(--au); padding: 0.7rem 0.9rem; }
  .proc-risks { margin-top: 2.5rem; background: #fff; border: 1px solid var(--g1); border-radius: 4px; padding: 1.8rem 2rem; }
  .proc-risks__t { font-size: 0.85rem; color: var(--g); font-weight: 600; margin-bottom: 0.8rem; }
  .proc-risks__i { font-size: 0.85rem; color: #666; line-height: 2; }
  .proc-risks__i strong { color: var(--g); font-weight: 600; }

  /* TRACK RECORD：フラッグシップカード */
  .tr-flag { margin-top: 2rem; display: block; background: rgba(255,255,255,0.05); border: 1px solid #cca45b; border-radius: 4px; padding: 2.5rem 2rem; text-decoration: none; transition: background 0.4s ease, transform 0.4s ease; }
  .tr-flag:hover { background: rgba(255,255,255,0.1); transform: translateY(-4px); }
  .tr-flag__tag { color: #cca45b; font-size: 0.78rem; letter-spacing: 0.12em; margin-bottom: 1.2rem; }
  .tr-flag__t { color: #fff; font-size: 1.25rem; margin-bottom: 0.9rem; font-family: 'Noto Serif JP', serif; }
  .tr-flag__d { color: rgba(255,255,255,0.75); font-size: 0.9rem; line-height: 1.9; margin-bottom: 1.2rem; }
  .tr-flag__link { color: #cca45b; font-size: 0.85rem; letter-spacing: 0.08em; display: inline-flex; align-items: center; gap: 0.4rem; }

</style>

<header class="nav" id="nav">
<div class="nav__i">
<a href="/" class="nav__logo"><img src="/logo/logo0001.png" alt="信越科学産業株式会社"/></a>
<nav class="nav__ls">
<a href="#vision" class="nav__l" data-ja="ビジョン"><span>VISION</span></a>
<a href="#about" class="nav__l" data-ja="経営陣紹介"><span>ABOUT US</span></a>
<a href="#services" class="nav__l" data-ja="サービス"><span>SERVICE</span></a>
