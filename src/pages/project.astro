---
import Layout from '../layouts/Layout.astro';
import News from '../components/news.astro';
import Aboutksdi from '../components/aboutksdi.astro';
import Services from '../components/services.astro';
import Contact from '../components/contact.astro';

// ===== SEO：検索結果の表示（タイトル・説明文）と構造化データ =====
const pageTitle = "凱信数基株式会社　｜　南九州GW級データセンタープロジェクト運用事業者";
const pageDesc  = "凱信数基株式会社（Kai Shin Digital Infrastructure Inc.）は、鹿児島県薩摩川内市で350MWから起動し1GWを目指すAIデータセンターを開発・運営する事業会社です。CDIB Capitalと信越科学産業の合弁により、脱炭素電力で動く南九州GW級AI計算基盤を構築します。";
const orgLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "凱信数基株式会社",
  "alternateName": ["Kai Shin Digital Infrastructure Inc.", "凱信数基", "Kaishin Digital Infrastructure"],
  "url": "https://ssibov.com/project/",
  "logo": "https://ssibov.com/logo/Kaishin_Geometric_Logo.png",
  "description": pageDesc,
  "foundingDate": "2026-01-20",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "サーキュラーパーク一丁目1番地",
    "addressLocality": "薩摩川内市",
    "addressRegion": "鹿児島県",
    "addressCountry": "JP"
  },
  "areaServed": "JP",
  "knowsAbout": ["AIデータセンター", "GPU計算基盤", "脱炭素電力", "薩摩川内", "鹿児島"]
};
---

<Layout title={pageTitle} description={pageDesc}>
<script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(orgLd)} />

<style is:global>
  /* ========================================================= */
  /* 全体設定 */
  /* ========================================================= */
  :root {
    --au: #b08d3b; /* SSIゴールド */
    --g: #333;   /* ダークグレー */
    --w: #fff;   /* ホワイト */
  }

  /* ★ 固定ヘッダーの高さ分、アンカーリンクのスクロール位置を補正 */
  html { scroll-padding-top: 90px; }

  .hero__up {
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
    padding-top: 8rem !important; 
    padding-bottom: 2rem;
    padding-left: 4vw;   /* ★ hero__c ラッパーが無いため左右余白をここで確保 */
    padding-right: 4vw;
    text-align: left;
  }
  
  /* ========================================================= */
  /* ★ タイトルの調整（フォントサイズ縮小と表示スペース拡大） */
  /* ========================================================= */
  .hero__t {
    font-size: 2.2rem !important; /* フォントサイズを縮小 */
    white-space: nowrap; /* 意図しない途中改行を防止 */
    line-height: 1.5 !important;
  }
  .st {
    font-size: 1.8rem !important; /* セクションタイトルのフォントサイズを縮小 */
    white-space: nowrap; /* 意図しない途中改行を防止 */
    line-height: 1.5 !important;
  }
  
  /* ★ Visionセクション：グリッド列比率でテキストエリアを広げる
     （.vis__gはLayout側でdisplay:gridのため、flex指定は効かず左列が過度に狭くなっていた） */
  @media (min-width: 1025px) {
    .vis__g { grid-template-columns: 1.15fr 1fr !important; gap: 4rem !important; }
  }

  /* ★ 中間幅(タブレット・小型ノートPC)でのタイトルはみ出し防止 */
  @media (max-width: 1100px) {
    .hero__t, .st { white-space: normal !important; }
  }

  /* スマホ閲覧時は画面外へのはみ出しを防ぐため折り返しを許可 */
  @media (max-width: 768px) {
    .hero__t { font-size: 1.4rem !important; white-space: normal; }
    .st { font-size: 1.4rem !important; white-space: normal; }
  }

  /* ========================================================= */
  /* アコーディオン設定（EPCページと同一フォーマット：ホバーで下方向に展開） */
  /* ベースのスタイルはLayout.astro側の定義をそのまま使用 */
  /* ========================================================= */
  .why-card {
    cursor: pointer;
  }
  .why-card__panel {
    max-height: 0 !important;
    opacity: 0 !important;
    visibility: hidden !important;
    overflow: hidden !important;
    margin-top: 0 !important;
    transition: max-height 0.6s ease, opacity 0.6s ease, margin-top 0.6s ease !important;
  }
  .why-card:hover .why-card__panel {
    max-height: 2000px !important; /* コンテンツ全体が収まる十分な高さ */
    opacity: 1 !important;
    visibility: visible !important;
    margin-top: 1.5rem !important;
  }
  .why-card__title-arrow {
    display: none !important;
  }

  /* ========================================================= */
  /* アコーディオン内の画像を上下30%伸ばす（縦幅拡張／EPCと同一） */
  /* ========================================================= */
  .why-card__images .why-card__img img {
    width: 100% !important;
    height: auto !important;
    /* 通常の16:9比率から、高さを30%アップさせた比率(16:11.7)に設定 */
    aspect-ratio: 16 / 11.7 !important;
    object-fit: cover !important;
  }

  /* ========================================================= */
  /* ★ Hero動画の余白解消 */
  /* ========================================================= */
  .hero__video {
    width: 100%;
    max-width: 1000px;
    aspect-ratio: 20 / 9; /* ★ スクリーン比率を20:9に設定 */
    overflow: hidden;
    position: relative;
    border-radius: 8px;
    border: 1px solid rgba(0,0,0,0.1);
  }
  .hero__video video {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    height: 100%;
    width: auto;
    aspect-ratio: 22 / 9; /* ★ 動画に焼き込まれた上下の黒帯をトリミングして表示 */
    object-fit: cover;    /* ★ 上下の黒い線を見えなくする */
  }

  /* ========================================================= */
  /* PROJECT ROADMAP */
  /* ========================================================= */
  .hero__ph { width: 100%; max-width: 1000px; margin: 4rem auto 0; text-align: left; }
  .ph__lab { display: flex; align-items: center; margin-bottom: 2rem; }
  .ph__lab::before { display: none !important; } /* ★ Layout側の線と重複するため非表示（線を1本に） */
  .ph__lab-line { width: 40px; height: 1px; background-color: var(--au); margin-right: 1rem; }
  .ph__lab-text { color: var(--au); font-size: 0.85rem; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 600; }
  
  .ph__container { background-color: #ffffff; border: 1px solid rgba(0,0,0,0.1); border-radius: 2px; padding: 4rem 2rem 0; display: flex; flex-direction: column; }
  .ph__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0; justify-items: stretch; } /* ★ 350と1,000の2枚を中央に均等配置 */
  .ph-c { position: relative; padding: 0 2.5rem 4rem; display: flex; flex-direction: column; align-items: flex-start; border-right: 1px solid #eee; } /* ★ 2枚構成に合わせ左右余白を拡大 */
  .ph-c:last-child { border-right: none; }
  .ph-c__st { display: inline-block; font-size: 10px; font-weight: 600; letter-spacing: .15em; text-transform: uppercase; padding: 4px 12px; border-radius: 2px; margin-bottom: 1.2rem; }
  .ph-c__st--a { background: rgba(176,141,59,.1); color: var(--au); }
  .ph-c__st--p { background: #f0f0f0; color: #888; }
  .ph-c__num { font-size: 3rem; font-weight: 300; color: var(--g); line-height: 1; margin-bottom: .2rem; }
  .ph-c__unit { font-size: 1rem; font-weight: 300; color: #aaa; margin-bottom: 1.2rem; font-family: 'DM Sans', sans-serif; }
  .ph-c__title { font-size: 1.15rem; font-weight: 400; color: var(--g); margin-bottom: .6rem; font-family: 'Noto Serif JP', serif; }
  .ph-c__desc { font-size: 0.85rem; line-height: 1.7; color: #666; font-weight: 300; margin-bottom: 2rem; }
  .ph-c__bar { position: absolute; bottom: 0; left: 0; height: 3px; background: var(--au); }

  @media (max-width: 768px) {
    .ph__grid { grid-template-columns: 1fr; }
    .ph-c { border-right: none; border-bottom: 1px solid #eee; }
  }

  /* ========================================================= */
  /* VISIONセクション：動画の位置 */
  /* ========================================================= */
  .vis__img {
    position: relative;
    overflow: hidden;
  }
  .vis__img video {
    position: absolute;
    bottom: 0;
    right: -15%;
    width: 115%;
    height: 100%;
    object-fit: cover;
    object-position: right bottom;
  }
</style>

<header class="nav" id="nav">
  <div class="nav__i">
    <a href="/" class="nav__logo"><img src="/logo/Kaishin_Geometric_Logo.png" alt="信越科学産業株式会社"/></a>
    <nav class="nav__ls">
      <a href="#vision" class="nav__l" data-ja="ビジョン"><span>VISION</span></a>
      <a href="#about" class="nav__l" data-ja="会社紹介"><span>ABOUT US</span></a>
      <a href="#services" class="nav__l" data-ja="サービス"><span>SERVICE</span></a>
      <a href="#projects" class="nav__l" data-ja="プロジェクト"><span>PROJECT</span></a>
      <a href="#contact" class="nav__l" data-ja="仕事依頼" style="text-align:center; line-height:1.2;"><span>CONSTRUCTION<br>REQUEST</span></a>
    </nav>
    <button class="ham" id="ham" aria-label="メニュー"><span></span><span></span><span></span></button>
  </div>
</header>

<div class="mmenu" id="mm">
  <a href="#vision" onclick="cm()" data-ja="ビジョン"><span>VISION</span></a>
  <a href="#about" onclick="cm()" data-ja="会社紹介"><span>ABOUT US</span></a>
  <a href="#services" onclick="cm()" data-ja="サービス"><span>SERVICE</span></a>
  <a href="#projects" onclick="cm()" data-ja="プロジェクト"><span>PROJECT</span></a>
  <a href="#contact" onclick="cm()" data-ja="仕事依頼" style="text-align:center; line-height:1.1;"><span>CONSTRUCTION<br>REQUEST</span></a>
</div>

<section class="hero">
  <div class="hero__up">
    <p class="hero__ey">凱信数基株式会社 — Satsumasendai, Kagoshima 1GW AI Data Center Cluster</p>
    <!-- ★ メインコピーのテキスト変更 -->
    <h1 class="hero__t">既存産業を加速させる計算力を地域産業へ開放する<br><em style="color:var(--au); font-style:normal;">産業を開発し、生産し、販売し、メンテナンスを促進する</em></h1>
    <p class="hero__sub">鹿児島県薩摩川内市にて、約37ヘクタールの用地に最大1GWのAIデータセンタークラスターを整備. 既存産業の設計、調達、建設、物流、メンテナンスを加速する事業創生を狙い、継続的な投資と雇用を生み出す能動的な経済エンジンを構築します.</p>
    <div class="hero__video">
      <!-- ★ loop属性なし、Endedイベントで切り替え -->
      <video id="hero-video" src="/movie/movie0001.mp4" autoplay muted playsinline></video>
    </div>
  </div>

  <!-- ★ EPCページと同じ「なぜ」アコーディオンブロック -->
  <div class="hero__why">
  <div class="why__grid">
  <div class="why-card">
  <div class="why-card__header">
    <div class="why-card__icon"><i data-lucide="zap" style="width:24px;height:24px"></i></div>
    <div class="why-card__title">なぜ鹿児島か</div>
    <div class="why-card__desc">GW級クリーン電力、熱意溢れる鹿児島県民、TSMC熊本に続く南九州の成長源泉</div>
  </div>
  <div class="why-card__panel"><div class="why-card__panel-inner">
  <div class="why-card__images">
    <div class="why-card__img"><img src="/image/image0001.jpg" alt="電力構成"/><div class="why-card__img-caption">九州電力構成 — 65%グリーン＆クリーン電源</div></div>
    <div class="why-card__img"><img src="/image/image0002.jpg" alt="熱意溢れる鹿児島県民"/><div class="why-card__img-caption">真剣かつ迅速な地方政府支援と熱意溢れる県民性</div></div>
    <div class="why-card__img"><img src="/image/image0003.jpg" alt="TSMC熊本に続く成長の柱"/><div class="why-card__img-caption">半導体と次世代産業の産業基盤</div></div>
  </div>
  <div class="why-card__detail">
    鹿児島は、GW級のクリーン電力を長期かつ安定的に供給できる希少な地域であり、熱意あふれる県民と行政の一体的な取り組みにより、先端産業の受け皿としての基盤を備えている。重要港湾である川内港に隣接し、物流・通信の両面で優位性を持つ中、TSMC熊本を起点とする半導体サプライチェーンの拡大と連動し、南九州における新たな成長源泉として、AIデータセンターを核に日本全体へComputing Powerを供給する拠点となる。
  </div>
  </div></div>
  </div>
  <div class="why-card">
  <div class="why-card__header">
    <div class="why-card__icon"><i data-lucide="brain" style="width:24px;height:24px"></i></div>
    <div class="why-card__title">なぜAIデータセンターか</div>
    <div class="why-card__desc">クラウドデータセンターにはない、地域経済への波及効果、AI活用した製造業高度化、日台連携によるAIDCオペレーター</div>
  </div>
  <div class="why-card__panel"><div class="why-card__panel-inner">
  <div class="why-card__images">
    <div class="why-card__img"><img src="/image/image0004.jpg" alt="経済効果"/><div class="why-card__img-caption">大規模電力需要と設備投資による直接的な経済効果</div></div>
    <div class="why-card__img"><img src="/image/image0005.jpg" alt="AI活用による産業高度化"/><div class="why-card__img-caption">AIを活用した設計・製造・物流・開発・販売の革命</div></div>
    <div class="why-card__img"><img src="/image/image0006.jpg" alt="日台AIDCオペレーター"/><div class="why-card__img-caption">日台によるAIDCオペレーター誕生</div></div>
  </div>
  <div class="why-card__detail">
    AIデータセンターは従来のクラウド型と異なり、高密度電力と先端設備を必要とするため、地域に大規模な設備投資と電力需要を生み出す。また、高度な運用を担う人材の集積を促し、雇用の質を向上させる。さらに、半導体やAI産業との連携を通じて関連企業の集積を誘発し、地域経済を単なる消費型から生産・創出型へと転換させる中核インフラとなる。
  </div>
  </div></div>
  </div>
  <div class="why-card">
  <div class="why-card__header">
    <div class="why-card__icon"><i data-lucide="shield" style="width:24px;height:24px"></i></div>
    <div class="why-card__title">GX国家戦略との整合</div>
    <div class="why-card__desc">国家戦略並びに地方政府と連動し、地元AI需要創生とAIを活用した日本産業の設計・製造・物流そして販売を活性化</div>
  </div>
  <div class="why-card__panel"><div class="why-card__panel-inner">
  <div class="why-card__images">
    <div class="why-card__img"><img src="/image/image0007.jpg" alt="アジア大洋州光通信網"/><div class="why-card__img-caption">アジア大洋州とつながる鹿児島発の光通信網</div></div>
    <div class="why-card__img"><img src="/image/image0008.jpg" alt="薩摩川内市港のコンテナ物流化"/><div class="why-card__img-caption">コンテナ物流を導入する隣接港と物流発展及び革命</div></div>
    <div class="why-card__img"><img src="/image/image0009.jpg" alt="大型設備投資"/><div class="why-card__img-caption">インフラ建設とメンテナンス過程で発生する地元雇用創出</div></div>
  </div>
  <div class="why-card__detail">
    本計画は、日本政府のGX政策および地方分散型データセンター政策に合致し、再生可能・低炭素電源を前提としたGX型インフラを構築するものである。先端半導体とそれを活用したAIデータセンターを核に、国内における地元AI需要を創出するとともに、地域に根ざしたオペレーターの育成・創出を図る。さらに、日本事業者が設備・運営に主体的に関与し、産官学連携を通じて持続的な産業基盤と新たな事業機会を地域に生み出す。
  </div>
  </div></div>
  </div>
  </div>
  </div>

  <div class="hero__ph" id="projects">
    <div class="ph__lab">
      <span class="ph__lab-line"></span>
      <span class="ph__lab-text">PROJECT ROADMAP</span>
    </div>
    <div class="ph__container">
      <div class="ph__grid">
        <div class="ph-c">
          <span class="ph-c__st ph-c__st--a">推進中</span>
          <div class="ph-c__num">350</div>
          <div class="ph-c__unit">MW — Phase 1</div>
          <div class="ph-c__title">大規模AIDC本格稼働</div>
          <div class="ph-c__desc">350MWから段階的に拡張し、大規模AIデータセンターを本格稼働. 特別高圧の受変電設備、蓄電システム、液冷・空調設備を本格導入し、AI学習・推論の大規模ワークロードに対応します. Wistron社AIサーバー組立工場の併設と川内港の港湾物流を核に、部材調達から据え付けまでを一貫化するサプライチェーンを地域に集積します.</div>
          <div class="ph-c__bar" style="width:20%;"></div>
        </div>
        <div class="ph-c">
          <span class="ph-c__st ph-c__st--p">将来構想</span>
          <div class="ph-c__num">1,000</div>
          <div class="ph-c__unit">MW — Phase 2</div>
          <div class="ph-c__title">1GW Cluster</div>
          <div class="ph-c__desc">最大1GWのクラスターへ拡張し、LLM創生からPhysical AIの社会実装までを担う国産AI基盤を確立. RAG技術を活用したIC設計LLMなどにより精密機械産業の競争力向上に貢献するとともに、AIDC各分野における国産プレイヤーの創出と、地域に根ざした産業エコシステムの形成を推進します.</div>
          <div class="ph-c__bar" style="width:5%; background:#ccc;"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="hero__sc"><span>Scroll</span><div class="hero__sc-l"></div></div>
</section>

<News kaishin_only={true} />

<section class="sec sec--c" id="vision">
  <div class="sec__in">
    <div class="vis__g">
      <div class="rv">
        <div class="ey">VISION</div>
        <!-- ★ タイトルのテキスト変更 -->
        <h2 class="st" style="color:var(--g)">鹿児島でできる<br>鹿児島だからできる</h2>
        <p class="sd">鹿児島県はAI需要を展開するPhysical AIを実装したクライアントを誘致し、GW級クラスターを建設します.</p>
        <div class="vis__stats">
          <div><div class="sn">1GW</div><div class="sl">最大電力容量</div></div>
          <div><div class="sn">約37ha</div><div class="sl">総用地面積</div></div>
        </div>
      </div>
      <div class="vis__img rv">
        <video src="/movie/movie0006.mp4" autoplay muted loop playsinline></video>
      </div>
    </div>
  </div>
</section>

<Aboutksdi />
<Services />
<Contact />

<footer class="ft">
  <div class="ft__in">
    <div class="ft__top">
      <div class="ft__cta">日本の次なる産業基盤を、<br>共に創りませんか.</div>
      <div class="ft__nav">
        <a href="#vision" data-ja="ビジョン"><span>VISION</span></a>
        <a href="#about" data-ja="会社紹介"><span>ABOUT US</span></a>
        <a href="#services" data-ja="サービス"><span>SERVICE</span></a>
        <a href="#projects" data-ja="プロジェクト"><span>PROJECT</span></a>
