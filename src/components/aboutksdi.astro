---
import { dict, makeL, localizeNews, type Lang } from '../i18n';
interface Props { lang?: Lang; kaishin_only?: boolean }
const { lang = 'ja' } = Astro.props as Props;
const t = dict('aboutksdi', lang);
const L = makeL(lang);
// 凱信数基株式会社 会社紹介（ABOUT US）
// project.astro の <About /> と差し替えて表示するコンポーネント。
// ナビ・フッター・index.astro からのリンク（/project#about）を維持するため id="about" を保持している。
---
<style is:global>
  /* ========================================================= */
  /* 凱信数基 会社紹介（スコープ付きスタイル） */
  /* ========================================================= */
  .ak-lead { font-size: 1rem; font-weight: 300; line-height: 2; color: rgba(255,255,255,.7); max-width: 760px; }
  .ak-lead strong { color: #fff; font-weight: 500; }

  .ak-sub { font-size: 10px; font-weight: 600; letter-spacing: .3em; text-transform: uppercase; color: var(--au); margin-bottom: 1.2rem; display: flex; align-items: center; gap: 1rem; }
  .ak-sub::before { content: ''; width: 2rem; height: 1px; background: var(--au); }
  .ak-h3 { font-family: 'Noto Serif JP', serif; font-size: 1.35rem; font-weight: 400; line-height: 1.6; margin-bottom: 1.2rem; }
  .ak-p { font-size: .92rem; font-weight: 300; line-height: 2; }

  /* 区切りブロック */
  .ak-blk { margin-top: 6rem; padding-top: 4rem; border-top: 1px solid rgba(255,255,255,.08); }
  .ak-blk--l { border-top-color: var(--g1); }

  /* 2カラム（見出し＋本文） */
  .ak-two { display: grid; grid-template-columns: 1fr 1.6fr; gap: 4rem; align-items: start; }

  /* 3つの約束 */
  .ak-pro { display: grid; grid-template-columns: repeat(3,1fr); gap: 2px; margin-top: 3rem; }
  .ak-pro__c { padding: 2.5rem 2rem; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.06); transition: all .5s; position: relative; overflow: hidden; }
  .ak-pro__c::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 2px; background: var(--au); transform: scaleX(0); transform-origin: left; transition: transform .6s cubic-bezier(.16,1,.3,1); }
  .ak-pro__c:hover { background: rgba(255,255,255,.08); border-color: var(--au); }
  .ak-pro__c:hover::before { transform: scaleX(1); }
  .ak-pro__n { font-size: 2rem; font-weight: 300; color: var(--aul); line-height: 1; margin-bottom: 1.2rem; font-family: 'DM Sans', sans-serif; }
  .ak-pro__t { font-size: 1.1rem; font-weight: 400; color: #fff; margin-bottom: .8rem; font-family: 'Noto Serif JP', serif; }
  .ak-pro__d { font-size: .82rem; line-height: 1.9; color: rgba(255,255,255,.65); font-weight: 300; }


  /* 定義リスト型テーブル（項目｜内容） */
  .ak-dl { width: 100%; border-collapse: collapse; }
  .ak-dl th, .ak-dl td { text-align: left; vertical-align: top; padding: 1.1rem 1rem; font-size: .88rem; font-weight: 300; line-height: 1.8; border-bottom: 1px solid rgba(255,255,255,.1); }
  .ak-dl th { width: 9rem; font-weight: 500; color: var(--aul); letter-spacing: .05em; white-space: nowrap; }
  .ak-dl td { color: rgba(255,255,255,.8); }
  .ak-dl--l th, .ak-dl--l td { border-bottom-color: var(--g1); }
  .ak-dl--l th { color: var(--au); }
  .ak-dl--l td { color: var(--ch); }

  /* 強み */
  .ak-str { display: grid; grid-template-columns: repeat(4,1fr); gap: 1px; background: rgba(255,255,255,.08); margin-top: 3rem; border: 1px solid rgba(255,255,255,.08); }
  .ak-str__c { background: var(--gd); padding: 2rem 1.6rem; transition: background .4s; }
  .ak-str__c:hover { background: rgba(255,255,255,.05); }
  .ak-str__i { color: var(--aul); margin-bottom: 1.2rem; opacity: .8; }
  .ak-str__t { font-size: .98rem; font-weight: 400; color: #fff; margin-bottom: .7rem; line-height: 1.5; }
  .ak-str__d { font-size: .78rem; line-height: 1.8; color: rgba(255,255,255,.6); font-weight: 300; }

  /* 汎用テーブル（ライト背景・複数列） */
  .ak-tbl-wrap { overflow-x: auto; margin-top: 2.5rem; }
  .ak-tbl { width: 100%; border-collapse: collapse; background: var(--w); border: 1px solid var(--g1); }
  .ak-tbl thead th { background: var(--gd); color: #fff; font-size: 11px; letter-spacing: .12em; font-weight: 500; padding: 1rem 1.2rem; text-align: left; white-space: nowrap; }
  .ak-tbl tbody td { padding: 1.2rem; font-size: .85rem; line-height: 1.8; font-weight: 300; color: var(--ch); vertical-align: top; border-top: 1px solid var(--g1); }
  .ak-tbl tbody tr:hover td { background: var(--cr); }
  .ak-tbl tbody td:first-child { font-weight: 500; color: var(--g); }
  .ak-tbl--pol tbody td:first-child { width: 22%; }
  .ak-tbl--pol tbody td:nth-child(2) { width: 42%; color: var(--g5); }
  .ak-tbl--pol tbody td:nth-child(3) { color: var(--g); font-weight: 400; }
  .ak-note { font-size: .82rem; line-height: 1.9; color: var(--g5); font-weight: 300; margin-top: 1.5rem; max-width: 800px; }

  /* 役員 */
  .ak-off { display: grid; grid-template-columns: repeat(5,1fr); gap: 1px; background: var(--g1); border: 1px solid var(--g1); margin-top: 2.5rem; }
  .ak-off__c { background: var(--w); padding: 2rem 1.6rem; transition: background .4s; position: relative; }
  .ak-off__c:hover { background: var(--cr); }
  .ak-off__c::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 2px; background: var(--au); transform: scaleX(0); transform-origin: left; transition: transform .6s cubic-bezier(.16,1,.3,1); }
  .ak-off__c:hover::before { transform: scaleX(1); }
  .ak-off__r { font-size: 10px; letter-spacing: .15em; text-transform: uppercase; color: var(--au); font-weight: 600; margin-bottom: .8rem; min-height: 2.4em; }
  .ak-off__n { font-size: 1.25rem; font-weight: 400; color: var(--g); line-height: 1.4; margin-bottom: .3rem; font-family: 'Noto Serif JP', serif; }
  .ak-off__e { font-size: .75rem; color: var(--g3); margin-bottom: 1rem; font-family: 'DM Sans', sans-serif; letter-spacing: .03em; }
  .ak-off__d { font-size: .8rem; line-height: 1.8; color: var(--g5); font-weight: 300; }

  /* パートナー */
  .ak-ptn { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 2rem; }
  .ak-ptn span { font-size: .82rem; font-weight: 400; color: var(--g); padding: .55rem 1.1rem; border: 1px solid var(--g1); background: var(--w); border-radius: 2px; transition: all .3s; }
  .ak-ptn span:hover { border-color: var(--au); color: var(--au); }

  /* ライト側の見出し */
  .ak-lt .ak-h3 { color: var(--g); }
  .ak-lt .ak-p { color: var(--g5); }

  /* ========================================================= */
  /* レスポンシブ */
  /* ========================================================= */
  @media (max-width: 1100px) {
    .ak-str { grid-template-columns: repeat(2,1fr); }
    .ak-off { grid-template-columns: repeat(3,1fr); }
  }
  @media (max-width: 1024px) {
    .ak-two { grid-template-columns: 1fr; gap: 2rem; }
    .ak-pro { grid-template-columns: 1fr; gap: 1px; }
    .ak-blk { margin-top: 4rem; padding-top: 3rem; }
  }
  @media (max-width: 768px) {
    .ak-str, .ak-off { grid-template-columns: 1fr; }
    .ak-dl th { width: auto; display: block; padding-bottom: 0; border-bottom: none; }
    .ak-dl td { display: block; padding-top: .3rem; }
    .ak-tbl--pol thead { display: none; }
    .ak-tbl--pol tbody td { display: block; width: auto !important; border-top: none; padding: .6rem 1.2rem; }
    .ak-tbl--pol tbody tr { display: block; border-top: 1px solid var(--g1); padding: .8rem 0; }
    .ak-tbl--pol tbody td::before { content: attr(data-l); display: block; font-size: 10px; letter-spacing: .15em; color: var(--au); font-weight: 600; margin-bottom: .2rem; }
  }
</style>

<!-- ========================================================= -->
<!-- ABOUT US ① 凱信数基とは（ダーク） -->
<!-- ========================================================= -->
<section class="sec sec--d" id="about">
  <div class="sec__in">

    <!-- 見出し・キャッチコピー・リード -->
    <div class="rv" style="max-width:820px">
      <div class="ey">About Us — Kai Shin Digital Infrastructure</div>
      <h2 class="st"><Fragment set:html={t.about_001} /></h2>
      <p class="ak-lead"><Fragment set:html={t.about_002} /></p>
    </div>

    <!-- 私たちについて -->
    <div class="ak-blk rv">
      <div class="ak-two">
        <div>
          <div class="ak-sub">{t.about_003}</div>
          <h3 class="ak-h3"><Fragment set:html={t.about_004} /></h3>
        </div>
        <p class="ak-p" style="color:rgba(255,255,255,.75)">{t.about_005}</p>
      </div>

      <!-- 3つの約束 -->
      <div class="ak-pro">
        <div class="ak-pro__c">
          <div class="ak-pro__n">01</div>
          <div class="ak-pro__t">{t.about_006}</div>
          <div class="ak-pro__d">{t.about_007}</div>
        </div>
        <div class="ak-pro__c">
          <div class="ak-pro__n">02</div>
          <div class="ak-pro__t">{t.about_008}</div>
          <div class="ak-pro__d">{t.about_009}</div>
        </div>
        <div class="ak-pro__c">
          <div class="ak-pro__n">03</div>
          <div class="ak-pro__t">{t.about_010}</div>
          <div class="ak-pro__d">{t.about_011}</div>
        </div>
      </div>
    </div>

    <!-- 私たちの強み -->
    <div class="ak-blk rv">
      <div class="ak-sub">{t.about_012}</div>
      <h3 class="ak-h3">{t.about_013}</h3>
      <div class="ak-str">
        <div class="ak-str__c">
          <div class="ak-str__i"><i data-lucide="zap" style="width:22px;height:22px"></i></div>
          <div class="ak-str__t">{t.about_014}</div>
          <div class="ak-str__d">{t.about_015}</div>
        </div>
        <div class="ak-str__c">
          <div class="ak-str__i"><i data-lucide="droplets" style="width:22px;height:22px"></i></div>
          <div class="ak-str__t">{t.about_016}</div>
          <div class="ak-str__d">{t.about_017}</div>
        </div>
        <div class="ak-str__c">
          <div class="ak-str__i"><i data-lucide="layers" style="width:22px;height:22px"></i></div>
          <div class="ak-str__t">{t.about_018}</div>
          <div class="ak-str__d">{t.about_019}</div>
        </div>
        <div class="ak-str__c">
          <div class="ak-str__i"><i data-lucide="globe" style="width:22px;height:22px"></i></div>
          <div class="ak-str__t">{t.about_020}</div>
          <div class="ak-str__d">{t.about_021}</div>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- ========================================================= -->
<!-- ABOUT US ② 地域とともに／会社概要／役員／パートナー（ライト） -->
<!-- ========================================================= -->
<section class="sec sec--c ak-lt" id="company" style="padding-top:7rem">
  <div class="sec__in">

    <!-- 地域とともに -->
    <div class="rv">
      <div class="ey">{t.company_022}</div>
      <h2 class="st" style="color:var(--g)">{t.company_023}</h2>
      <p class="sd">{t.company_024}</p>

      <div class="ak-tbl-wrap">
        <table class="ak-tbl ak-tbl--pol">
          <thead>
            <tr><th>{t.company_025}</th><th>{t.company_026}</th><th>{t.company_027}</th></tr>
          </thead>
          <tbody>
            <tr>
              <td data-l="鹿児島県の政策">{t.company_028}</td>
              <td data-l="掲げられた方向性">{t.company_029}</td>
              <td data-l="当社の取り組み">{t.company_030}</td>
            </tr>
            <tr>
              <td data-l="鹿児島県の政策">{t.company_031}</td>
              <td data-l="掲げられた方向性">{t.company_032}</td>
              <td data-l="当社の取り組み">{t.company_033}</td>
            </tr>
            <tr>
              <td data-l="鹿児島県の政策">{t.company_034}</td>
              <td data-l="掲げられた方向性">{t.company_035}</td>
              <td data-l="当社の取り組み">{t.company_036}</td>
            </tr>
            <tr>
              <td data-l="鹿児島県の政策">{t.company_037}</td>
              <td data-l="掲げられた方向性">{t.company_038}</td>
              <td data-l="当社の取り組み">{t.company_039}</td>
            </tr>
            <tr>
              <td data-l="鹿児島県の政策">{t.company_040}</td>
              <td data-l="掲げられた方向性">{t.company_041}</td>
