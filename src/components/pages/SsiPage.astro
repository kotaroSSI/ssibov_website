<script is:inline>
  // ヒーロー動画のループ設定
  const heroVideo = document.getElementById('hero-video');
  const playlist = [
    '/movie/modular%20dc%20oveall.mp4',
    '/movie/modular%20dc%20engineering.mp4',
    '/movie/movieXXXX.mp4',
    encodeURI('/movie/PDU電源ケーブル接続動画生成.mp4'),
    '/movie/movie00A3.mp4'
  ];
  let currentVideoIndex = 0;
  if (heroVideo) {
    heroVideo.addEventListener('ended', () => {
      currentVideoIndex = (currentVideoIndex + 1) % playlist.length;
      heroVideo.src = playlist[currentVideoIndex];
      // 最後の動画のみ映る範囲を上方向に20%ずらす（他の動画は中央のまま）
      heroVideo.style.objectPosition = currentVideoIndex === playlist.length - 1 ? '50% 30%' : '';
      heroVideo.play().catch(e => console.log('Play error:', e));
    });
  }

  // PROJECTセクションのホバー動画再生ロジック
  document.addEventListener("DOMContentLoaded", () => {
    const projectCards = document.querySelectorAll('.project-card');
    
    projectCards.forEach(card => {
      const video = card.querySelector('.pc__video');
      if (video) {
        card.addEventListener('mouseenter', () => {
          video.play().catch(e => console.error("Video play prevented:", e));
        });
        card.addEventListener('mouseleave', () => {
          video.pause();
        });
      }
    });
  });
</script>

</Layout>