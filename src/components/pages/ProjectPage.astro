    <div class="vis__g">
      <div class="rv">
        <div class="ey">VISION</div>
        <!-- ★ タイトルのテキスト変更 -->
        <h2 class="st" style="color:var(--g)"><Fragment set:html={t.vision_048} /></h2>
        <p class="sd">{t.vision_049}</p>
        <div class="vis__stats">
          <div><div class="sn">1GW</div><div class="sl">{t.vision_050}</div></div>
        </div>
      </div>
      <div class="vis__img rv">
        <video src="/movie/movie0006.mp4" autoplay muted loop playsinline></video>
      </div>
    </div>
  </div>
</section>

<Aboutksdi lang={lang} />
<Services lang={lang} />
<Contact lang={lang} />

<footer class="ft">
  <div class="ft__in">
    <div class="ft__top">
      <div class="ft__cta"><Fragment set:html={t.vision_053} /></div>
      <div class="ft__nav">
        <a href="#vision" data-ja={t.vision_054}><span>VISION</span></a>
        <a href="#about" data-ja={t.vision_055}><span>ABOUT US</span></a>
        <a href="#services" data-ja={t.vision_056}><span>SERVICE</span></a>
        <a href="#projects" data-ja={t.vision_057}><span>PROJECT</span></a>
        <a href="#contact" data-ja={t.vision_058} style="text-align:right; line-height:1.2;"><span>CONSTRUCTION<br>REQUEST</span></a>
      </div>
    </div>
    <div class="ft__bot">
      <span>&copy; 2026 Shinetsu Science Industry Co., Ltd. All Rights Reserved.</span>
    </div>
  </div>
</footer>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    // ヒーロー動画の連続再生ロジック
    const heroVideo = document.getElementById('hero-video');
    if (heroVideo) {
      const playlist = [
        '/movie/movie0001.mp4',
        '/movie/movie0002.mp4',
        '/movie/movie0003.mp4',
        '/movie/movie0004.mp4'
      ];
      let currentIndex = 0;

      heroVideo.addEventListener('ended', () => {
        currentIndex++;
        if (currentIndex >= playlist.length) {
          currentIndex = 0;
        }
        heroVideo.src = playlist[currentIndex];
        heroVideo.play().catch(e => console.error('Video Play Error:', e));
      });
    }

    // アコーディオンはEPCページと同じくCSSホバーで展開（JS制御なし）
  });
</script>

</Layout>