---
import { dict, makeL, localizeNews, type Lang } from '../../i18n';
import LangSwitch from '../LangSwitch.astro';
import Layout from '../../layouts/Layout.astro';
import newsData from '../../data/news.json';


interface Props {
  news: {
    id: string;
    date: string;
    title: string;
    category: string;
    content: string;
    full_content?: string;
    description: string;
    images?: Array<{
      url: string;
      caption?: string;
    }>;
    links?: Array<{
      title: string;
      url: string;
      organization: string;
    }>;
  };
}

const { lang = 'ja', news: rawNews } = Astro.props as Props & { lang?: Lang };
const t = dict('article', lang);
const L = makeL(lang);
const news = localizeNews(rawNews as any, lang);
const PATH = `/news/${news.id}/`;
const siteSuffix = lang === 'en' ? 'Kaishin Digital Infrastructure' : lang === 'zh' ? '凱信數基 Kaishin Digital Infrastructure' : '凱信数基 Kaishin Digital Infrastructure';

// JSONから他のニュースアイテムを取得（関連ニュース用）
const otherNews = [...newsData]
  .filter(n => n.id !== news.id)
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 3)
  .map((n) => localizeNews(n as any, lang));

// 日付フォーマット
const formattedDate = news.date.replace(/-/g, '.');

// 本文：full_content があれば空行で段落分割、無ければ従来どおり description + content
const paragraphs = news.full_content
  ? news.full_content.split(/\n{2,}/).map((s) => s.trim()).filter(Boolean)
  : [news.description, news.content].filter(Boolean);

const images = news.images ?? [];
---

<Layout lang={lang} path={PATH} title={`${news.title} | ${siteSuffix}`} description={news.description}>

<style is:global>
  .nav--s .lsw{display:flex !important}
  .news-hero {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 72.5px;
    background: linear-gradient(135deg, var(--g) 0%, rgba(20,20,20,0.8) 100%);
  }

  .news-hero__in {
    max-width: 900px;
    width: 100%;
    padding: 0 2rem;
  }

  .news-hero__meta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .news-hero__date {
    font-size: 0.95rem;
    font-family: 'DM Sans', sans-serif;
    color: #cca45b;
    letter-spacing: 0.05em;
  }

  .news-hero__category {
    display: inline-block;
    padding: 0.4rem 1rem;
    background: rgba(204, 164, 91, 0.2);
    border: 1px solid #cca45b;
    border-radius: 2px;
    font-size: 0.75rem;
    color: #cca45b;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .news-hero__title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    line-height: 1.4;
    color: #fff;
    font-family: 'Noto Serif JP', serif;
    font-weight: 600;
  }

  .news-content {
    padding: 6rem 0;
  }

  .news-content__body {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .news-content__images {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin: 2rem auto 3rem;
  }

  .news-content__figure {
    margin: 0;
  }

  .news-content__figure img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
  }

  .news-content__caption {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    line-height: 1.6;
    color: rgba(0,0,0,0.55);
    text-align: center;
  }

  .news-content__text {
    font-size: 0.95rem;
    line-height: 1.9;
    color: rgba(0,0,0,0.8);
    margin-bottom: 2rem;
  }

  .news-content__text p {
    margin-bottom: 1.5rem;
  }

  .news-related {
    background: #f8f8f8;
    padding: 4rem 2rem;
    margin-top: 4rem;
  }

  .news-related__title {
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 2rem;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }

  .news-related__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .news-card {
    background: #fff;
    border-radius: 4px;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .news-card:hover {
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    transform: translateY(-4px);
  }

  .news-card__date {
    padding: 1.5rem 1.5rem 0;
    font-size: 0.85rem;
    color: #999;
    font-family: 'DM Sans', sans-serif;
  }

  .news-card__title {
    padding: 0.5rem 1.5rem 1.5rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--g);
    font-weight: 500;
    text-decoration: none;
  }

  .news-card a {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .news-card a:hover .news-card__title {
    color: #cca45b;
  }

  .news-links {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid #ddd;
  }

  .news-links__title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--g);
    margin-bottom: 1.5rem;
  }

  .news-links__list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .news-link {
    display: block;
    padding: 1.2rem;
    background: #f9f9f9;
    border-left: 3px solid #cca45b;
    border-radius: 2px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .news-link:hover {
    background: #f0f0f0;
    transform: translateX(4px);
  }

  .news-link__org {
    font-size: 0.75rem;
    font-family: 'DM Sans', sans-serif;
    color: #cca45b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.3rem;
  }

  .news-link__title {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--g);
    font-weight: 500;
  }

  .news-link:hover .news-link__title {
    color: #cca45b;
  }

  @media (max-width: 600px) {
    .news-hero {
      min-height: 50vh;
    }

    .news-hero__meta {
      flex-direction: column;
      align-items: flex-start;
    }

    .news-hero__title {
      font-size: 1.5rem;
    }
  }
</style>

<!-- ヘッダー（ロゴ＋言語切替） -->
<header class="nav nav--s" id="nav">
  <div class="nav__i">
    <a href={L('/project')} class="nav__logo"><img src="/logo/Kaishin_Geometric_Logo.png" alt="Kaishin Digital Infrastructure"/></a>
    <LangSwitch lang={lang} path={PATH} />
  </div>
</header>

<!-- ヒーローセクション -->
<section class="news-hero">
  <div class="news-hero__in">
    <div class="news-hero__meta">
      <span class="news-hero__date">{formattedDate}</span>
      <span class="news-hero__category">{news.category}</span>
    </div>
    <h1 class="news-hero__title">{news.title}</h1>
  </div>
</section>

<!-- コンテンツセクション -->
<section class="news-content">
  <div class="news-content__body">
    <!-- 記事画像 -->
    {images.length > 0 && (
      <div class="news-content__images">
        {images.map((img) => (
          <figure class="news-content__figure">
            <img src={img.url} alt={img.caption ?? news.title} loading="lazy" />
            {img.caption && <figcaption class="news-content__caption">{img.caption}</figcaption>}
          </figure>
        ))}
      </div>
    )}

    <!-- テキストコンテンツ -->
    <div class="news-content__text">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>

    <!-- 関連リンク -->
    {news.links && news.links.length > 0 && (
      <div class="news-links">
        <h3 class="news-links__title">{t.top_001}</h3>
        <div class="news-links__list">
          {news.links.map((link) => (
            <a href={link.url} target="_blank" rel="noopener noreferrer" class="news-link">
              <div class="news-link__org">{link.organization}</div>
              <div class="news-link__title">{link.title}</div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<!-- 関連ニュース -->
{otherNews.length > 0 && (
  <section class="news-related">
    <h2 class="news-related__title">{t.top_002}</h2>
    <div class="news-related__grid">
      {otherNews.map((item) => (
        <div class="news-card">
          <a href={L(`/news/${item.id}`)}>
            <div class="news-card__date">
              {item.date.replace(/-/g, '.')}
            </div>
            <div class="news-card__title">
              {item.title}
            </div>
          </a>
        </div>
      ))}
    </div>
  </section>
)}

</Layout>
