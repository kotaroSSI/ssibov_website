---
import { dict, makeL, localizeNews, type Lang } from '../i18n';
interface Props { lang?: Lang; kaishin_only?: boolean }
const { lang = 'ja' } = Astro.props as Props;
const t = dict('services', lang);
const L = makeL(lang);

---
<section class="sec sec--w" id="services">
  <div class="sec__in">
    <div class="svh rv">
      <div><div class="ey">SERVICES</div><h2 class="st" style="color:var(--g)"><Fragment set:html={t.services_001} /></h2></div>
      <p class="sd">{t.services_002}</p>
    </div>
    <div class="svg2 rv">
      <div class="svc"><div class="svc__ic"><i data-lucide="map" style="width:28px;height:28px"></i></div><div class="svc__t">{t.services_003}</div><div class="svc__d">{t.services_004}</div></div>
      <div class="svc"><div class="svc__ic"><i data-lucide="pen-tool" style="width:28px;height:28px"></i></div><div class="svc__t">{t.services_005}</div><div class="svc__d">{t.services_006}</div></div>
      <div class="svc"><div class="svc__ic"><i data-lucide="server" style="width:28px;height:28px"></i></div><div class="svc__t">{t.services_007}</div><div class="svc__d">{t.services_008}</div></div>
      <div class="svc"><div class="svc__ic"><i data-lucide="hard-hat" style="width:28px;height:28px"></i></div><div class="svc__t">{t.services_009}</div><div class="svc__d">{t.services_010}</div></div>
      <div class="svc"><div class="svc__ic"><i data-lucide="zap" style="width:28px;height:28px"></i></div><div class="svc__t">{t.services_011}</div><div class="svc__d">{t.services_012}</div></div>
      <div class="svc"><div class="svc__ic"><i data-lucide="settings" style="width:28px;height:28px"></i></div><div class="svc__t">{t.services_013}</div><div class="svc__d">{t.services_014}</div></div>
    </div>
  </div>
</section>