                <input type="radio" name="inquiry_type" value="建設・施工" /> {t.contact_207}
              </label>
            </div>
          </div>

          <div class="fr">
            <div class="ff"><input type="text" placeholder={t.contact_208} name="company_name" required/></div>
            <div class="ff"><input type="text" placeholder={t.contact_209} name="department_name"/></div>
          </div>

          <div class="fr">
            <div class="ff"><input type="text" placeholder={t.contact_210} name="contact_name" required/></div>
            <div class="ff"><input type="email" placeholder="Email Address ※" required name="email"/></div>
          </div>

          <div class="fr">
            <div class="ff"><input type="text" placeholder={t.contact_211} name="dc_capacity"/></div>
            <div class="ff"><input type="text" placeholder={t.contact_212} name="dc_address"/></div>
          </div>

          <div class="ff">
            <textarea rows="4" maxlength="200" placeholder={t.contact_213} name="special_requests"></textarea>
          </div>

          <button class="sbtn" type="submit" style="margin-top:1.5rem">
            <span>Submit Inquiry</span><span class="sbtn__l"></span>
          </button>
        </form>

        <!-- 送信内容の確認 -->
        <div id="ssi-confirm" style="display:none;">
          <h3 style="font-size:1.25rem;font-weight:500;color:var(--g);margin-bottom:1rem;">{t.cf_title}</h3>
          <p style="font-size:.9rem;color:var(--g5);line-height:1.9;margin-bottom:2rem;">{t.cf_lead}</p>
          <table class="ct-confirm__tbl"><tbody id="ssi-confirm-rows"></tbody></table>
          <p id="ssi-error" style="display:none;color:#a63d2f;font-size:.85rem;margin-top:1.5rem;">{t.cf_error}</p>
          <div style="display:flex;gap:2.5rem;align-items:center;margin-top:2.5rem;flex-wrap:wrap;">
            <button type="button" id="ssi-back" class="sbtn" style="margin-top:0;"><span>&larr; {t.cf_back}</span><span class="sbtn__l"></span></button>
            <button type="button" id="ssi-send" class="ct-sendbtn">{t.cf_send}</button>
          </div>
        </div>

        <!-- 送信完了 -->
        <div id="ssi-thanks" style="display:none;">
          <h3 style="font-size:1.25rem;font-weight:500;color:var(--g);margin-bottom:1rem;">{t.th_title}</h3>
          <p style="font-size:.9rem;color:var(--g5);line-height:1.9;">{t.th_body}</p>
        </div>

        <script is:inline define:vars={{ ccCfg: { prefix: 'ssi', sending: t.cf_sending, send: t.cf_send, empty: t.cf_empty } }}>
        (function () {
          try {
            var form = document.getElementById(ccCfg.prefix + '-form');
            var box = document.getElementById(ccCfg.prefix + '-confirm');
            var rows = document.getElementById(ccCfg.prefix + '-confirm-rows');
            var thanks = document.getElementById(ccCfg.prefix + '-thanks');
            var errEl = document.getElementById(ccCfg.prefix + '-error');
            var back = document.getElementById(ccCfg.prefix + '-back');
            var send = document.getElementById(ccCfg.prefix + '-send');
            if (!form || !box) return;
            var radioLabelEl = form.querySelector('.ff span');
            var radioLabel = radioLabelEl ? radioLabelEl.textContent.replace(/[：:]\s*$/, '') : '';

            form.addEventListener('submit', function (e) {
              e.preventDefault();
              if (!form.reportValidity()) return;
              rows.innerHTML = '';
              var items = [];
              form.querySelectorAll('input, textarea').forEach(function (el) {
                if (el.type === 'hidden' || el.name === 'bot-field') return;
                if (el.type === 'radio') {
                  if (!el.checked) return;
                  items.push([radioLabel, el.parentElement.textContent.trim()]);
                  return;
                }
                var label = (el.getAttribute('placeholder') || el.name).replace(/\s*[※*]\s*$/, '');
                items.push([label, el.value.trim()]);
              });
              items.forEach(function (kv) {
                var tr = document.createElement('tr');
                var th = document.createElement('th'); th.textContent = kv[0];
                var td = document.createElement('td'); td.textContent = kv[1] || ccCfg.empty;
                tr.appendChild(th); tr.appendChild(td); rows.appendChild(tr);
              });
              form.style.display = 'none';
              box.style.display = 'block';
              errEl.style.display = 'none';
              box.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });

            back.addEventListener('click', function () {
              box.style.display = 'none';
              form.style.display = '';
              form.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });

            send.addEventListener('click', function () {
              send.disabled = true;
              send.textContent = ccCfg.sending;
              var body = new URLSearchParams(new FormData(form)).toString();
              fetch(window.location.pathname, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: body
              }).then(function (res) {
                if (!res.ok) throw new Error(res.status);
                box.style.display = 'none';
                thanks.style.display = 'block';
                thanks.scrollIntoView({ behavior: 'smooth', block: 'center' });
              }).catch(function () {
                errEl.style.display = 'block';
                send.disabled = false;
                send.textContent = ccCfg.send;
              });
            });
          } catch (e) {}
        })();
        </script>

      </div>

      <div class="rv" style="transition-delay:.2s; display:flex; flex-direction:column; gap:2rem;">

        <div style="background:var(--gd); padding:3.5rem; display:flex; flex-direction:column; justify-content:space-between; box-shadow:0 20px 40px rgba(0,0,0,0.05);">
          <div>
            <div style="font-size:10px; letter-spacing:.25em; text-transform:uppercase; color:var(--au); font-weight:600; margin-bottom:2rem; padding-bottom:1.5rem; border-bottom:1px solid rgba(255,255,255,.08);">
              HEADQUARTERS
            </div>
            <div style="font-size:0.95rem; line-height:2.2; color:#ffffff; font-weight:300;">
              <Fragment set:html={t.contact_214} />
            </div>
          </div>
          <div style="display:flex; gap:1.5rem; margin-top:3.5rem;">
            <a href="mailto:info@ssibov.com" style="color:var(--au); transition:color .3s;"><i data-lucide="mail" style="width:24px;height:24px"></i></a>
          </div>
        </div>

        <div style="box-shadow:0 20px 40px rgba(0,0,0,0.08); width:100%; aspect-ratio: 1 / 1; position:relative;">
          <div style="position:absolute; inset:0; background:var(--g1); z-index:0;"></div>
          <video src="/movie/contact.mp4" autoplay muted loop playsinline style="position:relative; z-index:1; width:100%; height:100%; object-fit:cover; display:block;"></video>
        </div>

      </div>
    </div>
  </div>
</section>

