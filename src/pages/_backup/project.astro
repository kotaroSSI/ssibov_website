---
import Layout from '../layouts/Layout.astro';
import News from '../components/news.astro';
import About from '../components/about.astro';
import Services from '../components/services.astro';
import Contact from '../components/contact.astro';
---

<Layout title="信越科学産業株式会社 | EPC — AI Infrastructure">

<style is:global>
  /* ========================================================= */
  /* 全体設定 */
  /* ========================================================= */
  .hero__up {
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
    padding-top: 8rem !important; 
    padding-bottom: 2rem;
    text-align: left;
  }
  
  /* ========================================================= */
  /* ★ 追加：タイトルのフォントサイズ縮小と表示スペース（右）の拡大 */
  /* ========================================================= */
  .hero__t {
    font-size: 2.2rem !important; /* フォントサイズを縮小 */
    white-space: nowrap; /* 意図しない途中改行を防止 */
    line-height: 1.5 !important;
  }
  .st {
    font-size: 1.8rem !important; /* セクションタイトルのフォントサイズを縮小 */
    white-space: nowrap; /* 意図しない途中改行を防止 */
    line-height: 1.5 !important;
  }
  
  /* Visionセクションなどの左側テキストエリアの幅を右に広げて余裕を持たせる */
  .vis__g .rv:first-child {
    flex: 0 0 55% !important; 
    max-width: 55% !important;
  }

  /* スマホ閲覧時は画面外へのはみ出しを防ぐため折り返しを許可 */
  @media (max-width: 768px) {
    .hero__t { font-size: 1.4rem !important; white-space: normal; }
    .st { font-size: 1.4rem !important; white-space: normal; }
    .vis__g .rv:first-child { flex: 0 0 100% !important; max-width: 100% !important; }
  }

  /* ========================================================= */
  /* アコーディオン設定 */
  /* ========================================================= */
  .hero__why {
    width: 100%;
    max-width: 1350px; 
    margin: 2rem auto 0;
    padding: 0 4vw;
    box-sizing: border-box;
  }
  .why__grid { display: flex; flex-direction: column; gap: 1rem; }
  .why-card {
    cursor: pointer; display: flex; flex-direction: row; 
    background: #fdfdfd; border: 1px solid rgba(0,0,0,0.1); border-radius: 8px; overflow: hidden; text-align: left; transition: background 0.3s ease;
  }
  .why-card:hover { background: #ffffff; }
  
  .why-card__header {
    width: 208px; 
    padding: 2rem 1.2rem; 
    flex-shrink: 0; display: flex; flex-direction: column; justify-content: center; border-right: 1px solid rgba(0,0,0,0.05);
  }
  .why-card__icon { color: var(--au); margin-bottom: 1rem; }
  .why-card__title { font-size: 1.2rem; color: #000 !important; margin-bottom: 0.5rem; font-family: 'Noto Serif JP', serif; line-height: 1.4; }
  .why-card__desc { font-size: 0.9rem; color: #333 !important; line-height: 1.5; }
  
  .why-card__panel {
    max-width: 0 !important; opacity: 0 !important; visibility: hidden !important; overflow: hidden !important;
    transition: max-width 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s ease !important;
  }
  .why-card:hover .why-card__panel { 
    max-width: 1050px !important; 
    opacity: 1 !important; visibility: visible !important; 
  }
  .why-card__panel-inner { 
    box-sizing: border-box; 
    width: 950px; 
    padding: 2rem; 
  }
  
  .why-card__images { 
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 1.5rem; 
    margin-left: 10%; 
    margin-right: 10%; 
  }
  .why-card__img { border-radius: 4px; overflow: hidden; position: relative; border: 1px solid #eee; }
  .why-card__img img { width: 100%; height: auto; aspect-ratio: 16/10; display: block; object-fit: cover; }
  .why-card__img-caption { font-size: 0.7rem; color: #666 !important; padding: 0.5rem; background: #f9f9f9; text-align: center; }
  .why-card__detail { font-size: 0.95rem; color: #222 !important; line-height: 1.7; border-top: 1px solid #eee; padding-top: 1rem; }

  @media (max-width: 1350px) {
    .why-card { flex-direction: column; }
    .why-card__header { width: 100%; border-right: none; border-bottom: 1px solid rgba(0,0,0,0.05); }
    .why-card__panel { max-height: 0 !important; max-width: 100% !important; transition: max-height 0.6s ease; }
    .why-card:hover .why-card__panel { max-height: 2500px !important; } 
    .why-card__panel-inner { width: 100%; }
    .why-card__images { margin-left: 0; margin-right: 0; } 
  }
  @media (max-width: 768px) {
    .why-card__images { grid-template-columns: 1fr; } 
  }

  /* ========================================================= */
  /* PROJECT ROADMAP */
  /* ========================================================= */
  .hero__ph { width: 100%; max-width: 1000px; margin: 4rem auto 0; text-align: left; }
  .ph__lab { display: flex; align-items: center; margin-bottom: 2rem; }
  .ph__lab-line { width: 40px; height: 1px; background-color: var(--au); margin-right: 1rem; }
  .ph__lab-text { color: var(--au); font-size: 0.85rem; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 600; }
  
  .ph__container { background-color: #ffffff; border: 1px solid rgba(0,0,0,0.1); border-radius: 2px; padding: 4rem 2rem 0; display: flex; flex-direction: column; }
  .ph__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; }
  .ph-c { position: relative; padding: 0 1.5rem 4rem; display: flex; flex-direction: column; align-items: flex-start; border-right: 1px solid #eee; }
  .ph-c:last-child { border-right: none; }
  .ph-c__st { display: inline-block; font-size: 10px; font-weight: 600; letter-spacing: .15em; text-transform: uppercase; padding: 4px 12px; border-radius: 2px; margin-bottom: 1.2rem; }
  .ph-c__st--a { background: rgba(176,141,59,.1); color: var(--au); }
  .ph-c__st--p { background: #f0f0f0; color: #888; }
  .ph-c__num { font-size: 3rem; font-weight: 300; color: var(--g); line-height: 1; margin-bottom: .2rem; }
  .ph-c__unit { font-size: 1rem; font-weight: 300; color: #aaa; margin-bottom: 1.2rem; font-family: 'Lora', serif; }
  .ph-c__title { font-size: 1.15rem; font-weight: 400; color: var(--g); margin-bottom: .6rem; font-family: 'Noto Serif JP', serif; }
  .ph-c__desc { font-size: 0.85rem; line-height: 1.7; color: #666; font-weight: 300; margin-bottom: 2rem; }
  .ph-c__bar { position: absolute; bottom: 0; left: 0; height: 3px; background: var(--au); }

  @media (max-width: 768px) {
    .ph__grid { grid-template-columns: 1fr; }
    .ph-c { border-right: none; border-bottom: 1px solid #eee; }
  }

  /* ========================================================= */
  /* VISIONセクション：動画の位置 */
  /* ========================================================= */
  .vis__img {
    position: relative;
    overflow: hidden;
  }
  .vis__img video {
    position: absolute;
    bottom: 0;
    right: -15%;
    width: 115%;
    height: 100%;
    object-fit: cover;
    object-position: right bottom;
  }
</style>

<header class="nav" id="nav">
  <div class="nav__i">
    <a href="/" class="nav__logo"><img src="/logo/logo0001.png" alt="信越科学産業株式会社"/></a>
    <nav class="nav__ls">
      <a href="#vision" class="nav__l" data-ja="ビジョン"><span>VISION</span></a>
      <a href="#about" class="nav__l" data-ja="経営陣紹介"><span>ABOUT US</span></a>
      <a href="#services" class="nav__l" data-ja="サービス"><span>SERVICE</span></a>
      <a href="#projects" class="nav__l" data-ja="プロジェクト"><span>PROJECT</span></a>
      <a href="#contact" class="nav__l" data-ja="仕事依頼" style="text-align:center; line-height:1.2;"><span>CONSTRUCTION<br>REQUEST</span></a>
    </nav>
    <button class="ham" id="ham" aria-label="メニュー"><span></span><span></span><span></span></button>
  </div>
</header>

<div class="mmenu" id="mm">
  <a href="#vision" onclick="cm()" data-ja="ビジョン"><span>VISION</span></a>
  <a href="#about" onclick="cm()" data-ja="経営陣紹介"><span>ABOUT US</span></a>
  <a href="#services" onclick="cm()" data-ja="サービス"><span>SERVICE</span></a>
  <a href="#projects" onclick="cm()" data-ja="プロジェクト"><span>PROJECT</span></a>
  <a href="#contact" onclick="cm()" data-ja="仕事依頼" style="text-align:center; line-height:1.1;"><span>CONSTRUCTION<br>REQUEST</span></a>
</div>

<section class="hero">
  <div class="hero__up">
    <p class="hero__ey">Satsumasendai, Kagoshima — 1GW AI Data Center Cluster</p>
    <h1 class="hero__t">既存産業を加速させる計算力を地域産業へ開放する<br><em style="color:var(--au); font-style:italic;">産業を開発し、生産し、販売し、メンテナンスを促進する</em></h1>
    <p class="hero__sub">鹿児島県薩摩川内市にて、32ヘクタールの用地に最大1GWのAIデータセンタークラスターを整備. 既存産業の設計、調達、建設、物流、メンテナンスを加速する事業創生を狙い、継続的な投資と雇用を生み出す能動的な経済エンジンを構築します.</p>
    <div class="hero__video">
      <video id="hero-video" src="/movie/movie0001.mp4" autoplay muted playsinline></video>
    </div>
  </div>

  <div class="hero__why">
    <div class="why__grid">
      <div class="why-card">
        <div class="why-card__header">
          <div class="why-card__icon"><i data-lucide="zap" style="width:24px;height:24px"></i></div>
          <div class="why-card__title">なぜ鹿児島か</div>
          <div class="why-card__desc">GW級クリーン電力、熱意溢れる鹿児島県民、TSMC熊本に続く南九州の成長源泉</div>
        </div>
        <div class="why-card__panel"><div class="why-card__panel-inner">
          <div class="why-card__images">
            <div class="why-card__img"><img src="/image/image0001.jpg" alt="電力構成"/><div class="why-card__img-caption">九州電力構成 — 65%グリーン＆クリーン電源</div></div>
            <div class="why-card__img"><img src="/image/image0002.jpg" alt="熱意"/><div class="why-card__img-caption">真剣かつ迅速な地方政府支援と熱意溢れる県民性</div></div>
            <div class="why-card__img"><img src="/image/image0003.jpg" alt="基盤"/><div class="why-card__img-caption">半導体と次世代産業の産業基盤</div></div>
          </div>
          <div class="why-card__detail">
            鹿児島は、GW級のクリーン電力を長期かつ安定的に供給できる希少な地域であり、熱意あふれる県民と行政の一体的な取り組みにより、先端産業の受け皿としての基盤を備えている。重要港湾である川内港に隣接し、物流・通信の両面で優位性を持つ中、TSMC熊本を起点とする半導体サプライチェーンの拡大と連動し、南九州における新たな成長源泉として、AIデータセンターを核に日本全体へComputing Powerを供給する拠点となる。
          </div>
        </div></div>
      </div>
      
      <div class="why-card">
        <div class="why-card__header">
          <div class="why-card__icon"><i data-lucide="brain" style="width:24px;height:24px"></i></div>
          <div class="why-card__title">なぜAIデータセンターか</div>
          <div class="why-card__desc">クラウドデータセンターにはない、地域経済への波及効果、AI活用した製造業高度化、日台連携によるAIDCオペレーター</div>
        </div>
        <div class="why-card__panel"><div class="why-card__panel-inner">
          <div class="why-card__images">
            <div class="why-card__img"><img src="/image/image0004.jpg" alt="経済効果"/><div class="why-card__img-caption">大規模電力需要と設備投資による直接的な経済効果</div></div>
            <div class="why-card__img"><img src="/image/image0005.jpg" alt="産業高度化"/><div class="why-card__img-caption">AIを活用した設計・製造・物流・開発・販売の革命</div></div>
            <div class="why-card__img"><img src="/image/image0006.jpg" alt="オペレーター"/><div class="why-card__img-caption">日台によるAIDCオペレーター誕生</div></div>
          </div>
          <div class="why-card__detail">
            AIデータセンターは従来のクラウド型と異なり、高密度電力と先端設備を必要とするため、地域に大規模な設備投資と電力需要を生み出す。また、高度な運用を担う人材の集積を促し、雇用の質を向上させる。さらに、半導体やAI産業との連携を通じて関連企業の集積を誘発し、地域経済を単なる消費型から生産・創出型へと転換させる中核インフラとなる。
          </div>
        </div></div>
      </div>
      
      <div class="why-card">
        <div class="why-card__header">
          <div class="why-card__icon"><i data-lucide="shield" style="width:24px;height:24px"></i></div>
          <div class="why-card__title">GX国家戦略との整合</div>
          <div class="why-card__desc">国家戦略並びに地方政府と連動し、地元AI需要創生とAIを活用した日本産業の設計・製造・物流そして販売を活性化</div>
        </div>
        <div class="why-card__panel"><div class="why-card__panel-inner">
          <div class="why-card__images">
            <div class="why-card__img"><img src="/image/image0007.jpg" alt="光通信網"/><div class="why-card__img-caption">アジア大洋州とつながる鹿児島発の光通信網</div></div>
            <div class="why-card__img"><img src="/image/image0008.jpg" alt="物流"/><div class="why-card__img-caption">コンテナ物流を導入する隣接港と物流発展及び革命</div></div>
            <div class="why-card__img"><img src="/image/image0009.jpg" alt="投資"/><div class="why-card__img-caption">インフラ建設とメンテナンス過程で発生する地元雇用創出</div></div>
          </div>
          <div class="why-card__detail">
            本計画は、日本政府のGX政策および地方分散型データセンター政策に合致し、再生可能・低炭素電源を前提としたGX型インフラを構築するものである。先端半導体とそれを活用したAIデータセンターを核に、国内における地元AI需要を創出するとともに、地域に根ざしたオペレーターの育成・創出を図る。さらに、日本事業者が設備・運営に主体的に関与し、産官学連携を通じて持続的な産業基盤と新たな事業機会を地域に生み出す。
          </div>
        </div></div>
      </div>
    </div>
  </div>

  <div class="hero__ph">
    <div class="ph__lab">
      <span class="ph__lab-line"></span>
      <span class="ph__lab-text">PROJECT ROADMAP</span>
    </div>
    <div class="ph__container">
      <div class="ph__grid">
        <div class="ph-c">
          <span class="ph-c__st ph-c__st--a">進行中</span>
          <div class="ph-c__num">10</div>
          <div class="ph-c__unit">MW — Phase 1</div>
          <div class="ph-c__title">Proof of Concept</div>
          <div class="ph-c__desc">初期約10MWで事業コンセプトを検証. 液冷システム実証と運用ノウハウを確立.</div>
          <div class="ph-c__bar" style="width:65%"></div>
        </div>
        <div class="ph-c">
          <span class="ph-c__st ph-c__st--p">計画中</span>
          <div class="ph-c__num">350</div>
          <div class="ph-c__unit">MW — Phase 2</div>
          <div class="ph-c__title">大規模AIDC本格稼働</div>
          <div class="ph-c__desc">350MWから段階的に拡張. Wistron社AIサーバー組立工場とサプライチェーン集積.</div>
          <div class="ph-c__bar" style="width:20%; background:#ccc;"></div>
        </div>
        <div class="ph-c">
          <span class="ph-c__st ph-c__st--p">将来構想</span>
          <div class="ph-c__num">1,000</div>
          <div class="ph-c__unit">MW — Phase 3</div>
          <div class="ph-c__title">1GW Cluster</div>
          <div class="ph-c__desc">LLM創生からPhysical AIを実装. RAG技術を活用し精密機械産業の競争力向上。</div>
          <div class="ph-c__bar" style="width:5%; background:#ccc;"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="hero__sc"><span>Scroll</span><div class="hero__sc-l"></div></div>
</section>

<News />

<section class="sec sec--c" id="vision">
  <div class="sec__in">
    <div class="vis__g">
      <div class="rv">
        <div class="ey">VISION</div>
        <h2 class="st" style="color:var(--g)">鹿児島でできる<br>鹿児島だからできる</h2>
        <p class="sd">鹿児島県はAI需要を展開するPhysical AIを実装したクライアントを誘致し、GW級クラスターを建設します.</p>
        <div class="vis__stats">
          <div><div class="sn">1GW</div><div class="sl">最大電力容量</div></div>
          <div><div class="sn">36.8ha</div><div class="sl">総用地面積</div></div>
        </div>
      </div>
      <div class="vis__img rv">
        <video src="/movie/movie0006.mp4" autoplay muted loop playsinline></video>
      </div>
    </div>
  </div>
</section>

<About />
<Services />
<Contact />

<footer class="ft">
  <div class="ft__in">
    <div class="ft__top">
      <div class="ft__cta">日本の次なる産業基盤を、<br>共に創りませんか.</div>
      <div class="ft__nav">
        <a href="#vision" data-ja="ビジョン"><span>VISION</span></a>
        <a href="#about" data-ja="経営陣紹介"><span>ABOUT US</span></a>
        <a href="#services" data-ja="サービス"><span>SERVICE</span></a>
        <a href="#projects" data-ja="プロジェクト"><span>PROJECT</span></a>
      </div>
    </div>
    <div class="ft__bot">
      <span>&copy; 2026 Shinetsu Science Industry Co., Ltd. All Rights Reserved.</span>
    </div>
  </div>
</footer>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const heroVideo = document.getElementById('hero-video');
    
    if (heroVideo) {
      const playlist = [
        '/movie/movie0001.mp4',
        '/movie/movie0002.mp4',
        '/movie/movie0003.mp4',
        '/movie/movie0004.mp4'
      ];
      let currentIndex = 0;

      heroVideo.addEventListener('ended', () => {
        currentIndex++;
        if (currentIndex >= playlist.length) {
          currentIndex = 0;
        }
        heroVideo.src = playlist[currentIndex];
        heroVideo.play().catch(e => console.error('Video Play Error:', e));
      });
    }
  });
</script>

</Layout>